style SettingsTheme {
    token inset: length = 16px;
    token ink: color = "#EAF1F8FF";
    padding: inset;
    gap: 10px;
    controlHeight: 42px;
    text: ink;
    background: "#142434FF";
    focus: "#66CCFFFF";
}

view SettingsView(model: SettingsModel) style SettingsTheme {
    Column(id: "root") {
        Label(id: "title", text: "Settings");
        Label(id: "name-label", text: "Player name");
        TextField(id: "name-field", value: bind model.draft.playerName,
            changed: model.Rename, enabled: bind model.CanEdit(), sensitive: true);
        Toggle(id: "vsync-toggle", label: "VSync", value: bind model.draft.vsync,
            changed: model.ChangeVSync, enabled: bind model.CanEdit(), sensitive: true);
        PercentStepper(id: "volume-stepper", label: "Volume", value: bind model.draft.volume,
            changed: model.ChangeVolume, enabled: bind model.CanEdit(), sensitive: true);
        Label(id: "save-status", value: bind model.StatusText());
        Label(id: "save-error", value: bind model.error);
        Row(id: "actions") {
            Button(id: "save-button", label: "Save", enabled: bind model.CanSave(), clicked: model.Save);
            Button(id: "revert-button", label: "Revert", enabled: bind model.CanEdit(), clicked: model.Revert);
        }
    }
}
