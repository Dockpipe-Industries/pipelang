@PACKAGE_INIT@
set(_PipeLangFileStreams_PREFIX "${PACKAGE_PREFIX_DIR}")

if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    message(FATAL_ERROR "This FileStreams package selects Linux x86_64 only")
endif()

foreach(dependency IN ITEMS CORE CRYPTO_STREAM)
    if(NOT DEFINED PIPELANG_${dependency}_MANIFEST_SHA256 OR "${PIPELANG_${dependency}_MANIFEST_SHA256}" STREQUAL "")
        message(FATAL_ERROR "Explicit ${dependency} manifest pin required")
    endif()
endforeach()
if(NOT PIPELANG_CORE_MANIFEST_SHA256 STREQUAL "@PIPELANG_CORE_MANIFEST_SHA256@" OR
        NOT PIPELANG_CRYPTO_STREAM_MANIFEST_SHA256 STREQUAL "@PIPELANG_CRYPTO_STREAM_MANIFEST_SHA256@")
    message(FATAL_ERROR "Dependency manifest differs from the selected FileStreams package's exact dependencies")
endif()

include(CMakeFindDependencyMacro)
find_dependency(PipeLangModel 0.1.0 EXACT CONFIG)
find_dependency(PipeLangCryptoStream 0.1.0 EXACT CONFIG)
if(NOT DEFINED PIPELANG_FILE_STREAMS_MANIFEST_SHA256 OR "${PIPELANG_FILE_STREAMS_MANIFEST_SHA256}" STREQUAL "")
    message(FATAL_ERROR "Explicit independent FileStreams manifest pin required")
endif()

set(PipeLangFileStreams_MANIFEST "${_PipeLangFileStreams_PREFIX}/@package_share@/sdk-manifest.json")
execute_process(COMMAND "${PipeLangModel_GENERATOR}" verify
    --prefix "${_PipeLangFileStreams_PREFIX}" --manifest "${PipeLangFileStreams_MANIFEST}"
    --sha256 "${PIPELANG_FILE_STREAMS_MANIFEST_SHA256}" RESULT_VARIABLE package_status)
if(NOT package_status EQUAL 0)
    message(FATAL_ERROR "Selected FileStreams package failed exact installed-content verification")
endif()

set(PipeLangFileStreams_SOURCE_LIBRARY_DIRECTORY "${_PipeLangFileStreams_PREFIX}/@package_share@/library")
set(PipeLangFileStreams_SOURCE_LIBRARY_SHA256 "@file_library_sha256@")
include("${CMAKE_CURRENT_LIST_DIR}/PipeLangFileStreamsTargets.cmake")
check_required_components(PipeLangFileStreams)
