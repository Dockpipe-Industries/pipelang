module PipeLang.Testing;

public Record TestResult {
    public string id;
    public string name;
    public TestOutcome outcome;
    public TestOutcome primaryOutcome;
    public TestPhase primaryPhase;
    public TestFailure? primaryFailure;
    public TestOutcome cleanupOutcome;
    public TestFailure? cleanupFailure;
    public bool bodyRan;
    public bool cleanupRan;
}
