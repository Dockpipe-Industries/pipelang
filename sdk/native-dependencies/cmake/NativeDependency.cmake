include_guard(GLOBAL)

function(pipelang_add_native_dependency name)
    cmake_parse_arguments(PARSE_ARGV 1 dependency "DEFAULT_FEATURES;TESTS"
        "LANGUAGE;SOURCE_DIRECTORY;MANIFEST;MANIFEST_SHA256;LOCK_FILE;LOCK_SHA256;TOOLCHAIN_FILE;TOOLCHAIN_SHA256;LIBRARY_NAME;PACKAGE;CACHE_DIRECTORY;ARTIFACT;RESTORE_ASSETS;RESTORE_ASSETS_SHA256;CMAKE_TOOLCHAIN;CMAKE_TOOLCHAIN_SHA256;BUILD_TARGET;RUSTFLAGS"
        "FEATURES;SYSTEM_LIBRARIES")
    if(dependency_UNPARSED_ARGUMENTS OR dependency_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Unexpected or incomplete native dependency arguments")
    endif()
    if(NOT name MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR TARGET "${name}")
        message(FATAL_ERROR "Native dependency requires a unique simple target name")
    endif()
    if(NOT dependency_LANGUAGE MATCHES "^(Rust|Go|CSharp|CMake)$")
        message(FATAL_ERROR "Unsupported native dependency language; select Rust, Go, CSharp or CMake explicitly")
    endif()
    foreach(argument SOURCE_DIRECTORY MANIFEST MANIFEST_SHA256 LOCK_FILE LOCK_SHA256 TOOLCHAIN_FILE TOOLCHAIN_SHA256 LIBRARY_NAME)
        if(NOT dependency_${argument})
            message(FATAL_ERROR "Native dependency requires ${argument}")
        endif()
    endforeach()
    if(NOT dependency_LIBRARY_NAME MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid native library name")
    endif()
    if(dependency_TESTS AND NOT dependency_LANGUAGE STREQUAL "Rust")
        message(FATAL_ERROR "TESTS currently supports Rust unit tests; other profiles use linked ABI fixtures")
    endif()
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/native-dependencies/${name}")
    file(MAKE_DIRECTORY "${directory}")
    set(request "${directory}/request.cmake")
    file(WRITE "${request}" "# Generated native dependency request.
")
    foreach(argument LANGUAGE SOURCE_DIRECTORY MANIFEST MANIFEST_SHA256 LOCK_FILE LOCK_SHA256 TOOLCHAIN_FILE TOOLCHAIN_SHA256 LIBRARY_NAME PACKAGE CACHE_DIRECTORY ARTIFACT RESTORE_ASSETS RESTORE_ASSETS_SHA256 CMAKE_TOOLCHAIN CMAKE_TOOLCHAIN_SHA256 BUILD_TARGET RUSTFLAGS FEATURES SYSTEM_LIBRARIES DEFAULT_FEATURES)
        set(value "${dependency_${argument}}")
        if(value MATCHES "\]====\]" OR value MATCHES "[\r\n]")
            message(FATAL_ERROR "Invalid native dependency argument ${argument}")
        endif()
        file(APPEND "${request}" "set(${argument} [====[${value}]====])\n")
    endforeach()
    file(APPEND "${request}" "set(BUILD_DIRECTORY [====[${directory}]====])\n")
    include("${request}")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/VerifyInputs.cmake")
    pipelang_verify_native_inputs()
    if(LANGUAGE STREQUAL "Rust")
        set(artifact "${directory}/cargo/${target_triple}/release/lib${LIBRARY_NAME}.a")
    elseif(LANGUAGE STREQUAL "Go")
        set(artifact "${directory}/lib${LIBRARY_NAME}.a")
    elseif(LANGUAGE STREQUAL "CSharp")
        set(artifact "${directory}/publish/${LIBRARY_NAME}.so")
    else()
        if(NOT ARTIFACT OR IS_ABSOLUTE "${ARTIFACT}" OR ARTIFACT MATCHES "(^|/)\.\.(/|$)")
            message(FATAL_ERROR "CMake requires a relative ARTIFACT within its build directory")
        endif()
        set(artifact "${directory}/cmake/${ARTIFACT}")
    endif()
    file(APPEND "${request}" "set(RESOLVED_ARTIFACT [====[${artifact}]====])\n")
    add_custom_target("${name}_build"
        COMMAND "${CMAKE_COMMAND}" "-DREQUEST=${request}" -DACTION=build
            -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunDependency.cmake"
        BYPRODUCTS "${artifact}" "${directory}/build-receipt.json"
        VERBATIM COMMENT "Resolve ${LANGUAGE} native dependency ${name}")
    if(LANGUAGE STREQUAL "CSharp")
        add_library("${name}" SHARED IMPORTED GLOBAL)
    else()
        add_library("${name}" STATIC IMPORTED GLOBAL)
    endif()
    set_target_properties("${name}" PROPERTIES IMPORTED_LOCATION "${artifact}"
        INTERFACE_LINK_LIBRARIES "${SYSTEM_LIBRARIES}")
    add_dependencies("${name}" "${name}_build")
    if(dependency_TESTS)
        add_custom_target("${name}_test"
            COMMAND "${CMAKE_COMMAND}" "-DREQUEST=${request}" -DACTION=test
                -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunDependency.cmake"
            VERBATIM)
    endif()
    set("${name}_ARTIFACT" "${artifact}" PARENT_SCOPE)
endfunction()
