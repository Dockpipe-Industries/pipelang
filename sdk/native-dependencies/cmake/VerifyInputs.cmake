function(pipelang_verify_digest path expected description)
    if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "${description} must be an existing absolute file")
    endif()
    string(LENGTH "${expected}" digest_length)
    if(NOT digest_length EQUAL 64 OR NOT expected MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "${description} requires a SHA256 digest")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${description} digest mismatch")
    endif()
endfunction()

macro(pipelang_verify_native_inputs)
    if(NOT LANGUAGE MATCHES "^(Rust|Go|CSharp|CMake)$")
        message(FATAL_ERROR "Unsupported native dependency language")
    endif()
    cmake_host_system_information(RESULT host_platform QUERY OS_PLATFORM)
    if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT host_platform MATCHES "^(x86_64|amd64|AMD64)$")
        message(FATAL_ERROR "Native dependency profiles currently require Linux x86-64")
    endif()
    if(NOT IS_ABSOLUTE "${SOURCE_DIRECTORY}" OR NOT IS_DIRECTORY "${SOURCE_DIRECTORY}")
        message(FATAL_ERROR "SOURCE_DIRECTORY must be an existing absolute directory")
    endif()
    pipelang_verify_digest("${MANIFEST}" "${MANIFEST_SHA256}" "Dependency manifest")
    pipelang_verify_digest("${LOCK_FILE}" "${LOCK_SHA256}" "Dependency lock")
    pipelang_verify_digest("${TOOLCHAIN_FILE}" "${TOOLCHAIN_SHA256}" "Toolchain manifest")
    file(READ "${TOOLCHAIN_FILE}" toolchain)
    string(JSON schema GET "${toolchain}" schema)
    string(JSON language GET "${toolchain}" language)
    string(JSON target_triple GET "${toolchain}" target)
    string(JSON tool_path GET "${toolchain}" path)
    if(NOT schema EQUAL 1 OR NOT language STREQUAL LANGUAGE)
        message(FATAL_ERROR "Toolchain schema/language mismatch")
    endif()
    if(NOT target_triple STREQUAL "x86_64-unknown-linux-gnu")
        message(FATAL_ERROR "Unqualified native dependency target; Linux x86-64 only")
    endif()
    string(JSON tool_count LENGTH "${toolchain}" tools)
    if(tool_count LESS 1 OR tool_count GREATER 16)
        message(FATAL_ERROR "Invalid toolchain tool count")
    endif()
    math(EXPR last_tool "${tool_count} - 1")
    set(verified_tools)
    foreach(index RANGE 0 ${last_tool})
        string(JSON tool_name MEMBER "${toolchain}" tools ${index})
        if(NOT tool_name MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR "Invalid tool identity")
        endif()
        string(JSON tool_${tool_name} GET "${toolchain}" tools ${tool_name} path)
        string(JSON tool_hash GET "${toolchain}" tools ${tool_name} sha256)
        string(JSON expected_version GET "${toolchain}" tools ${tool_name} version)
        string(JSON version_argument GET "${toolchain}" tools ${tool_name} version_argument)
        pipelang_verify_digest("${tool_${tool_name}}" "${tool_hash}" "Tool ${tool_name}")
        execute_process(COMMAND "${tool_${tool_name}}" "${version_argument}"
            RESULT_VARIABLE version_status OUTPUT_VARIABLE actual_version ERROR_VARIABLE version_error
            WORKING_DIRECTORY "${SOURCE_DIRECTORY}"
            TIMEOUT 15 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE)
        if(NOT version_status EQUAL 0 OR NOT actual_version STREQUAL expected_version)
            message(FATAL_ERROR "Tool ${tool_name} version mismatch")
        endif()
        list(APPEND verified_tools "${tool_name}")
    endforeach()
    if(LANGUAGE STREQUAL "Rust")
        set(required_tools cargo rustc)
        set(required_manifest "${SOURCE_DIRECTORY}/Cargo.toml")
        set(required_lock "${SOURCE_DIRECTORY}/Cargo.lock")
        if(NOT IS_ABSOLUTE "${CACHE_DIRECTORY}" OR NOT IS_DIRECTORY "${CACHE_DIRECTORY}")
            message(FATAL_ERROR "Rust requires a separately prepared Cargo cache")
        endif()
    elseif(LANGUAGE STREQUAL "Go")
        set(required_tools go cc)
        set(required_manifest "${SOURCE_DIRECTORY}/go.mod")
        set(required_lock "${SOURCE_DIRECTORY}/go.sum")
    elseif(LANGUAGE STREQUAL "CSharp")
        set(required_tools dotnet ilc)
        set(required_manifest "${MANIFEST}")
        set(required_lock "${SOURCE_DIRECTORY}/packages.lock.json")
        pipelang_verify_digest("${RESTORE_ASSETS}" "${RESTORE_ASSETS_SHA256}" "Locked restore assets")
    else()
        set(required_tools cmake cc cxx make)
        set(required_manifest "${SOURCE_DIRECTORY}/CMakeLists.txt")
        set(required_lock "${LOCK_FILE}")
        pipelang_verify_digest("${CMAKE_TOOLCHAIN}" "${CMAKE_TOOLCHAIN_SHA256}" "CMake toolchain")
    endif()
    if((LANGUAGE STREQUAL "Go" OR LANGUAGE STREQUAL "CSharp") AND (NOT IS_ABSOLUTE "${CACHE_DIRECTORY}" OR NOT IS_DIRECTORY "${CACHE_DIRECTORY}"))
        message(FATAL_ERROR "A separately prepared absolute dependency cache is required")
    endif()
    foreach(required IN LISTS required_tools)
        if(NOT required IN_LIST verified_tools)
            message(FATAL_ERROR "Toolchain is missing ${required}")
        endif()
    endforeach()
    file(REAL_PATH "${MANIFEST}" actual_manifest)
    file(REAL_PATH "${required_manifest}" required_manifest)
    if(NOT actual_manifest STREQUAL required_manifest)
        message(FATAL_ERROR "Select the language's actual project manifest")
    endif()
    file(REAL_PATH "${LOCK_FILE}" actual_lock)
    file(REAL_PATH "${required_lock}" required_lock)
    if(NOT actual_lock STREQUAL required_lock)
        message(FATAL_ERROR "Select the language's actual dependency lockfile")
    endif()
endmacro()
