# Repository compiler profiles are explicit and distinct from installed SDK use.
if(WIN32)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND MSVC_VERSION GREATER_EQUAL 1930)
        set(expected_profile windows-msvc)
    elseif(MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        set(expected_profile windows-clang-mingw)
        # Standalone tools must not load C++ runtime DLLs from a build host PATH.
        add_link_options(-static)
    else()
        message(FATAL_ERROR "The Windows native profile requires MSVC 19.30+ or native LLVM-MinGW Clang")
    endif()
elseif(APPLE)
    set(expected_profile macos-appleclang)
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
        message(FATAL_ERROR "The macOS native profile requires AppleClang")
    endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        set(expected_profile linux-gnu)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        set(expected_profile linux-clang)
    else()
        message(FATAL_ERROR "The Linux native profile requires GNU or Clang")
    endif()
else()
    message(FATAL_ERROR "No native compiler profile for ${CMAKE_SYSTEM_NAME}")
endif()
if(DEFINED PIPELANG_NATIVE_COMPILER_PROFILE AND NOT PIPELANG_NATIVE_COMPILER_PROFILE STREQUAL expected_profile)
    message(FATAL_ERROR "Selected native compiler profile differs from the actual compiler: ${expected_profile}")
endif()
set(PIPELANG_NATIVE_COMPILER_PROFILE "${expected_profile}" CACHE STRING "Selected native compiler profile")
message(STATUS "PipeLang compiler profile: ${PIPELANG_NATIVE_COMPILER_PROFILE}, ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")

# Apply native protocol startup and manifest data only to repository executables.
# Consumers retain ownership of their process startup and presentation streams.
if(WIN32)
    enable_language(RC)
    get_filename_component(PIPELANG_WINDOWS_SUPPORT_DIR
        "${CMAKE_CURRENT_LIST_DIR}/../../../../src/native/support" ABSOLUTE)
    file(TO_CMAKE_PATH "${PIPELANG_WINDOWS_SUPPORT_DIR}/windows.manifest" manifest_path)
    set(PIPELANG_WINDOWS_RESOURCE "${CMAKE_CURRENT_BINARY_DIR}/pipelang-windows-manifest.rc")
    file(WRITE "${PIPELANG_WINDOWS_RESOURCE}" "1 24 \"${manifest_path}\"\n")
    if(MSVC)
        add_compile_options(/utf-8)
    endif()
endif()

function(pipelang_native_finalize directory)
    if(NOT WIN32)
        return()
    endif()
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(kind "${target}" TYPE)
        if(kind STREQUAL "EXECUTABLE")
            target_sources("${target}" PRIVATE
                "${PIPELANG_WINDOWS_SUPPORT_DIR}/windows_entry.cpp"
                "${PIPELANG_WINDOWS_RESOURCE}")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        pipelang_native_finalize("${child}")
    endforeach()
endfunction()
