function(pipelang_add_model_bindings target)
    cmake_parse_arguments(PARSE_ARGV 1 model "STYLE_INSPECTION" "MODEL;SOURCE_SET;VIEW;NAMESPACE;OUTPUT_DIRECTORY" "")
    if(model_UNPARSED_ARGUMENTS OR model_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "pipelang_add_model_bindings received unexpected or incomplete arguments")
    endif()
    if(model_SOURCE_SET)
        message(FATAL_ERROR "View bindings do not support SOURCE_SET")
    endif()
    foreach(argument MODEL VIEW NAMESPACE OUTPUT_DIRECTORY)
        if(NOT model_${argument})
            message(FATAL_ERROR "pipelang_add_model_bindings requires ${argument}")
        endif()
    endforeach()
    if(TARGET "${target}")
        message(FATAL_ERROR "Model bindings target already exists: ${target}")
    endif()
    get_filename_component(model_source "${model_MODEL}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    get_filename_component(view_source "${model_VIEW}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    get_filename_component(view_extension "${view_source}" LAST_EXT)
    if(NOT view_extension STREQUAL ".pview" AND NOT view_extension STREQUAL ".pxml")
        message(FATAL_ERROR "VIEW requires a .pview or .pxml source; .vpipe is unsupported and ordinary MODEL sources retain .pipe")
    endif()
    get_filename_component(output "${model_OUTPUT_DIRECTORY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    set(outputs "${output}/StandaloneConstants.hpp" "${output}/Model.hpp" "${output}/model.json" "${output}/ModelView.hpp"
        "${output}/view.json" "${output}/bindings.json")
    set(inspection_arguments)
    if(model_STYLE_INSPECTION)
        list(APPEND outputs "${output}/style.json")
        list(APPEND inspection_arguments --style-inspection)
    endif()
    file(GLOB_RECURSE runtime_headers CONFIGURE_DEPENDS "${PipeLangModel_SDK_PREFIX}/@CMAKE_INSTALL_INCLUDEDIR@/pipelang/model/*.hpp")
    add_custom_command(OUTPUT ${outputs}
        COMMAND "${PipeLangModel_GENERATOR}" bindings
            --sdk-prefix "${PipeLangModel_SDK_PREFIX}"
            --sdk-manifest "${PipeLangModel_MANIFEST}"
            --sdk-manifest-sha256 "${PipeLangModel_MANIFEST_SHA256}"
            --model-compiler "${PipeLangModel_MODELC}" --view-compiler "${PipeLangModel_VIEWC}"
            --model "${model_source}" --view "${view_source}"
            --namespace "${model_NAMESPACE}" --output-directory "${output}"
            ${inspection_arguments}
        DEPENDS "${model_source}" "${view_source}" "${PipeLangModel_MANIFEST}"
            "${PipeLangModel_MODELC}" "${PipeLangModel_VIEWC}" "${PipeLangModel_GENERATOR}"
            ${runtime_headers}
        VERBATIM COMMENT "Compile typed PipeLang model and view bindings")
    add_custom_target("${target}_generate" DEPENDS ${outputs})
    add_library("${target}" INTERFACE)
    add_dependencies("${target}" "${target}_generate")
    target_link_libraries("${target}" INTERFACE PipeLang::ModelRuntime)
    set_property(TARGET "${target}" PROPERTY PIPELANG_CONSTANTS_HEADER "${output}/StandaloneConstants.hpp")
    target_include_directories("${target}" INTERFACE "${output}")
endfunction()

# Generate ordinary model code without a view or UI adapter dependency.
function(pipelang_add_model target)
    cmake_parse_arguments(PARSE_ARGV 1 model "" "MODEL;SOURCE_SET;PROJECT_ROOT;SOURCE_ROOT;ENTRY;NAMESPACE;OUTPUT_DIRECTORY;COMPILATION" "")
    if(model_UNPARSED_ARGUMENTS OR model_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "pipelang_add_model received unexpected or incomplete arguments")
    endif()
    foreach(argument NAMESPACE OUTPUT_DIRECTORY)
        if(NOT model_${argument})
            message(FATAL_ERROR "pipelang_add_model requires ${argument}")
        endif()
    endforeach()
    set(input_count 0)
    foreach(input MODEL SOURCE_SET PROJECT_ROOT)
        if(model_${input})
            math(EXPR input_count "${input_count} + 1")
        endif()
    endforeach()
    if(NOT input_count EQUAL 1)
        message(FATAL_ERROR "pipelang_add_model requires exactly one MODEL, SOURCE_SET or PROJECT_ROOT")
    endif()
    if(NOT model_COMPILATION)
        set(model_COMPILATION HEADER_ONLY)
    endif()
    if(NOT model_COMPILATION STREQUAL "HEADER_ONLY" AND NOT model_COMPILATION STREQUAL "COMPILED")
        message(FATAL_ERROR "COMPILATION must be HEADER_ONLY or COMPILED")
    endif()
    if(model_COMPILATION STREQUAL "COMPILED" AND NOT model_PROJECT_ROOT)
        message(FATAL_ERROR "Compiled model generation requires PROJECT_ROOT")
    endif()
    if(NOT model_PROJECT_ROOT AND (model_SOURCE_ROOT OR model_ENTRY))
        message(FATAL_ERROR "SOURCE_ROOT and ENTRY require PROJECT_ROOT")
    endif()
    if(TARGET "${target}")
        message(FATAL_ERROR "Model target already exists: ${target}")
    endif()
    if(model_PROJECT_ROOT)
        if(NOT model_ENTRY)
            message(FATAL_ERROR "PROJECT_ROOT requires ENTRY relative to SOURCE_ROOT")
        endif()
        if(NOT model_SOURCE_ROOT)
            set(model_SOURCE_ROOT src)
        endif()
        get_filename_component(project_root "${model_PROJECT_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set(project_information_command project-info)
        set(project_information_arguments)
        set(project_information_protocol pipelang.native-model-project-info.v1)
        if(model_COMPILATION STREQUAL "COMPILED")
            set(project_information_command project-compile-info)
            set(project_information_arguments --model-compiler "${PipeLangModel_MODELC}" --namespace "${model_NAMESPACE}")
            set(project_information_protocol pipelang.native-model-project-compile-info.v1)
        endif()
        execute_process(
            COMMAND "${PipeLangModel_GENERATOR}" "${project_information_command}" ${project_information_arguments}
                --sdk-prefix "${PipeLangModel_SDK_PREFIX}"
                --sdk-manifest "${PipeLangModel_MANIFEST}"
                --sdk-manifest-sha256 "${PipeLangModel_MANIFEST_SHA256}"
                --project-root "${project_root}" --source-root "${model_SOURCE_ROOT}" --entry "${model_ENTRY}"
            RESULT_VARIABLE project_result
            OUTPUT_VARIABLE project_information
            ERROR_VARIABLE project_error)
        if(NOT project_result EQUAL 0)
            message(FATAL_ERROR "PipeLang project admission failed: ${project_error}")
        endif()
        string(JSON project_protocol GET "${project_information}" protocol)
        if(NOT project_protocol STREQUAL project_information_protocol)
            message(FATAL_ERROR "PipeLang project information protocol mismatch")
        endif()
        string(JSON project_count LENGTH "${project_information}" dependencies)
        if(project_count LESS 1 OR project_count GREATER 4096)
            message(FATAL_ERROR "PipeLang project dependency inventory exceeds its bounds")
        endif()
        set(implementation_names)
        if(model_COMPILATION STREQUAL "COMPILED")
            string(JSON implementation_count LENGTH "${project_information}" implementation)
            if(implementation_count LESS 1 OR implementation_count GREATER 257)
                message(FATAL_ERROR "Compiled project artifact count exceeds its bounds")
            endif()
            math(EXPR implementation_last "${implementation_count} - 1")
            foreach(index RANGE 0 ${implementation_last})
                string(JSON artifact_name GET "${project_information}" implementation ${index} name)
                string(JSON artifact_kind GET "${project_information}" implementation ${index} kind)
                if(artifact_kind STREQUAL "implementation" AND artifact_name MATCHES "^Implementation_[0-9]+[.]cpp$")
                    list(APPEND implementation_names "${artifact_name}")
                elseif(NOT artifact_kind STREQUAL "private-header" OR NOT artifact_name STREQUAL "Objects.hpp")
                    message(FATAL_ERROR "Unknown compiler-owned artifact")
                endif()
            endforeach()
            string(JSON project_plan_sha256 GET "${project_information}" plan_sha256)
        endif()
        set(input_dependencies)
        math(EXPR project_last "${project_count} - 1")
        foreach(index RANGE 0 ${project_last})
            string(JSON dependency GET "${project_information}" dependencies ${index})
            list(APPEND input_dependencies "${dependency}")
        endforeach()
        # This glob watches only membership. The compiler-owned project index
        # resolves module declarations, imports and exports, never this helper.
        file(GLOB_RECURSE project_membership CONFIGURE_DEPENDS LIST_DIRECTORIES false
            "${project_root}/${model_SOURCE_ROOT}/*.pipe")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${input_dependencies})
        # Removing a source removes its prerequisite from the regenerated build
        # graph. Keep an explicit index identity dependency so deletion also
        # invalidates existing outputs when all remaining inputs are older.
        string(SHA256 project_input_identity "${project_information}")
        set(project_input_stamp "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${target}.pipelang-project-inputs")
        file(CONFIGURE OUTPUT "${project_input_stamp}" CONTENT "${project_input_identity}\n" @ONLY)
        list(APPEND input_dependencies "${project_input_stamp}")
        set(model_input_arguments --project-root "${project_root}"
            --source-root "${model_SOURCE_ROOT}" --entry "${model_ENTRY}")
        if(model_COMPILATION STREQUAL "COMPILED")
            list(APPEND model_input_arguments --compilation compiled --plan-sha256 "${project_plan_sha256}")
        endif()
    elseif(model_SOURCE_SET)
        get_filename_component(source_set "${model_SOURCE_SET}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        execute_process(
            COMMAND "${PipeLangModel_GENERATOR}" source-set-info
                --sdk-prefix "${PipeLangModel_SDK_PREFIX}"
                --sdk-manifest "${PipeLangModel_MANIFEST}"
                --sdk-manifest-sha256 "${PipeLangModel_MANIFEST_SHA256}"
                --source-set "${source_set}"
            RESULT_VARIABLE source_set_result
            OUTPUT_VARIABLE source_set_information
            ERROR_VARIABLE source_set_error)
        if(NOT source_set_result EQUAL 0)
            message(FATAL_ERROR "PipeLang source-set admission failed: ${source_set_error}")
        endif()
        string(JSON source_set_protocol GET "${source_set_information}" protocol)
        if(NOT source_set_protocol STREQUAL "pipelang.native-model-source-set-info.v1")
            message(FATAL_ERROR "PipeLang source-set information protocol mismatch")
        endif()
        string(JSON source_set_count LENGTH "${source_set_information}" dependencies)
        if(source_set_count LESS 2 OR source_set_count GREATER 129)
            message(FATAL_ERROR "PipeLang source-set dependency inventory exceeds its bounds")
        endif()
        set(input_dependencies)
        math(EXPR source_set_last "${source_set_count} - 1")
        foreach(index RANGE 0 ${source_set_last})
            string(JSON dependency GET "${source_set_information}" dependencies ${index})
            list(APPEND input_dependencies "${dependency}")
        endforeach()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_set}")
        set(model_input_arguments --source-set "${source_set}")
    else()
        get_filename_component(model_source "${model_MODEL}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set(input_dependencies "${model_source}")
        set(model_input_arguments --model "${model_source}")
    endif()
    get_filename_component(output "${model_OUTPUT_DIRECTORY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    set(outputs "${output}/StandaloneConstants.hpp" "${output}/Model.hpp" "${output}/model.json" "${output}/bindings.json")
    if(model_PROJECT_ROOT)
        list(APPEND outputs "${output}/Types.hpp")
    endif()
    set(implementation_sources)
    if(model_COMPILATION STREQUAL "COMPILED")
        list(APPEND outputs "${output}/Objects.hpp")
        foreach(name IN LISTS implementation_names)
            list(APPEND implementation_sources "${output}/${name}")
            list(APPEND outputs "${output}/${name}")
        endforeach()
    endif()
    file(GLOB_RECURSE runtime_headers CONFIGURE_DEPENDS "${PipeLangModel_SDK_PREFIX}/@CMAKE_INSTALL_INCLUDEDIR@/pipelang/model/*.hpp")
    add_custom_command(OUTPUT ${outputs}
        COMMAND "${PipeLangModel_GENERATOR}" model-bindings
            --sdk-prefix "${PipeLangModel_SDK_PREFIX}"
            --sdk-manifest "${PipeLangModel_MANIFEST}"
            --sdk-manifest-sha256 "${PipeLangModel_MANIFEST_SHA256}"
            --model-compiler "${PipeLangModel_MODELC}"
            ${model_input_arguments} --namespace "${model_NAMESPACE}"
            --output-directory "${output}"
        DEPENDS ${input_dependencies} "${PipeLangModel_MANIFEST}" "${PipeLangModel_MODELC}"
            "${PipeLangModel_GENERATOR}" ${runtime_headers}
        VERBATIM COMMENT "Compile headless PipeLang model")
    add_custom_target("${target}_generate" DEPENDS ${outputs})
    add_library("${target}" INTERFACE)
    add_dependencies("${target}" "${target}_generate")
    if(implementation_sources)
        if(TARGET "${target}_implementation")
            message(FATAL_ERROR "Compiled model implementation target already exists: ${target}_implementation")
        endif()
        add_library("${target}_implementation" STATIC ${implementation_sources})
        add_dependencies("${target}_implementation" "${target}_generate")
        target_compile_features("${target}_implementation" PRIVATE cxx_std_20)
        target_link_libraries("${target}_implementation" PRIVATE
            "$<BUILD_INTERFACE:PipeLang::ModelRuntime>"
            "$<INSTALL_INTERFACE:Threads::Threads>")
        target_include_directories("${target}_implementation" PRIVATE "${output}")
        set_target_properties("${target}_implementation" PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_EXTENSIONS OFF)
        target_link_libraries("${target}" INTERFACE "${target}_implementation")
        # Evaluate the facade's producer policy at generation time, including
        # settings added after this function returns and transitive policies.
        # Do not link the implementation back to the facade: that would create
        # a library dependency cycle. Link options already reach final callers.
        foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS COMPILE_FEATURES INCLUDE_DIRECTORIES)
            set_property(TARGET "${target}_implementation" APPEND PROPERTY "${property}"
                "$<TARGET_PROPERTY:${target},INTERFACE_${property}>")
        endforeach()
        target_include_directories("${target}_implementation" SYSTEM PRIVATE
            "$<TARGET_PROPERTY:${target},INTERFACE_SYSTEM_INCLUDE_DIRECTORIES>")
        set_property(TARGET "${target}" PROPERTY PIPELANG_IMPLEMENTATION_TARGET "${target}_implementation")
    endif()
    target_link_libraries("${target}" INTERFACE PipeLang::ModelRuntime)
    set_property(TARGET "${target}" PROPERTY PIPELANG_MODEL_COMPILATION "${model_COMPILATION}")
    set_property(TARGET "${target}" PROPERTY PIPELANG_CONSTANTS_HEADER "${output}/StandaloneConstants.hpp")
    target_include_directories("${target}" INTERFACE "${output}")
endfunction()

# Install a compiled project's private archive in its native static owner's
# package. Public generated headers and build-only producer policy stay private.
function(pipelang_install_model_implementation model)
    cmake_parse_arguments(PARSE_ARGV 1 ownership "" "OWNER;EXPORT;ARCHIVE_DESTINATION" "")
    if(ownership_UNPARSED_ARGUMENTS OR ownership_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "pipelang_install_model_implementation received unexpected or incomplete arguments")
    endif()
    foreach(argument OWNER EXPORT ARCHIVE_DESTINATION)
        if(NOT ownership_${argument})
            message(FATAL_ERROR "pipelang_install_model_implementation requires ${argument}")
        endif()
    endforeach()
    foreach(target "${model}" "${ownership_OWNER}")
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "Compiled model installation requires an existing target: ${target}")
        endif()
    endforeach()
    get_target_property(model_alias "${model}" ALIASED_TARGET)
    if(model_alias)
        set(model "${model_alias}")
    endif()
    get_target_property(owner_alias "${ownership_OWNER}" ALIASED_TARGET)
    if(owner_alias)
        set(ownership_OWNER "${owner_alias}")
    endif()
    get_target_property(owner_type "${ownership_OWNER}" TYPE)
    get_target_property(owner_imported "${ownership_OWNER}" IMPORTED)
    if(owner_imported OR NOT owner_type STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "Compiled model installation requires a native STATIC owner")
    endif()
    string(REPLACE "\\" "/" archive_destination "${ownership_ARCHIVE_DESTINATION}")
    if(IS_ABSOLUTE "${ownership_ARCHIVE_DESTINATION}" OR
       archive_destination MATCHES "(^|/)[.][.](/|$)" OR
       archive_destination MATCHES "[$]<")
        message(FATAL_ERROR "Compiled model archive destination must be a relative install path")
    endif()
    get_target_property(compilation "${model}" PIPELANG_MODEL_COMPILATION)
    if(NOT compilation STREQUAL "HEADER_ONLY" AND NOT compilation STREQUAL "COMPILED")
        message(FATAL_ERROR "Compiled model installation requires a PipeLang model facade")
    endif()
    if(compilation STREQUAL "HEADER_ONLY")
        return()
    endif()
    get_target_property(implementation "${model}" PIPELANG_IMPLEMENTATION_TARGET)
    # Record-only class libraries have no implementation archive to install.
    if(NOT implementation)
        return()
    endif()
    get_target_property(existing_export "${implementation}" PIPELANG_INSTALL_EXPORT)
    get_target_property(existing_destination "${implementation}" PIPELANG_INSTALL_DESTINATION)
    if(existing_export)
        if(NOT existing_export STREQUAL ownership_EXPORT OR
           NOT existing_destination STREQUAL ownership_ARCHIVE_DESTINATION)
            message(FATAL_ERROR "Compiled model archive already belongs to a different installation")
        endif()
    else()
        install(TARGETS "${implementation}" EXPORT "${ownership_EXPORT}"
            ARCHIVE DESTINATION "${ownership_ARCHIVE_DESTINATION}")
        set_property(TARGET "${implementation}" PROPERTY PIPELANG_INSTALL_EXPORT "${ownership_EXPORT}")
        set_property(TARGET "${implementation}" PROPERTY PIPELANG_INSTALL_DESTINATION "${ownership_ARCHIVE_DESTINATION}")
    endif()
    get_target_property(existing_owners "${implementation}" PIPELANG_INSTALL_OWNERS)
    if(NOT ownership_OWNER IN_LIST existing_owners)
        target_link_libraries("${ownership_OWNER}" PRIVATE "$<INSTALL_INTERFACE:${implementation}>")
        set_property(TARGET "${implementation}" APPEND PROPERTY PIPELANG_INSTALL_OWNERS "${ownership_OWNER}")
    endif()
endfunction()
