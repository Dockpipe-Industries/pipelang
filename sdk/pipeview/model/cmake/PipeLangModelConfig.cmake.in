@PACKAGE_INIT@
set(PipeLangModel_GENERATOR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/pipelang-sdk-tool@CMAKE_EXECUTABLE_SUFFIX@")
if(NOT "@model_installed_object_compiler@" STREQUAL "")
    set(PipeLangModel_OBJECTC "${PACKAGE_PREFIX_DIR}/@model_installed_object_compiler@")
else()
    unset(PipeLangModel_OBJECTC)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/PipeLangNativeExecutable.cmake")
set(PipeLangModel_NativeExecutable_FOUND TRUE)
set(PipeLangModel_NativeObject_FOUND TRUE)
set(_pipelang_model_non_native_components ${PipeLangModel_FIND_COMPONENTS})
list(REMOVE_ITEM _pipelang_model_non_native_components NativeExecutable NativeObject)
if(PipeLangModel_FIND_COMPONENTS AND NOT _pipelang_model_non_native_components)
    unset(_pipelang_model_non_native_components)
    check_required_components(PipeLangModel)
    return()
endif()
unset(_pipelang_model_non_native_components)

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/PipeLangModelTargets.cmake")
set(PipeLangModel_SDK_PREFIX "${PACKAGE_PREFIX_DIR}")
set(PipeLangModel_MODELC "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/pipelang-modelc@CMAKE_EXECUTABLE_SUFFIX@")
set(PipeLangModel_VIEWC "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/pipelang-model-viewc@CMAKE_EXECUTABLE_SUFFIX@")
if(NOT "@model_installed_application_runtime@" STREQUAL "")
    set(PipeLangModel_APPLICATION_RUNTIME_ARCHIVE "${PACKAGE_PREFIX_DIR}/@model_installed_application_runtime@")
endif()
set(PipeLangModel_SOURCE_LIBRARY_DIRECTORY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pipelang-model/libraries")
set(PipeLangModel_JSON_READER_SOURCE_DIRECTORY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pipelang-model/native/json")
set(PipeLangModel_CXX_RESOURCE_PROFILE_DIRECTORY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pipelang-model/compiler-profiles")
set(PipeLangModel_MANIFEST "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pipelang-model/sdk-manifest.json")
if(NOT EXISTS "${PipeLangModel_MANIFEST}")
    message(FATAL_ERROR "PipeLangModel SDK manifest is missing")
endif()
file(SHA256 "${PipeLangModel_MANIFEST}" PipeLangModel_MANIFEST_SHA256)
include("${CMAKE_CURRENT_LIST_DIR}/PipeLangModelCompileResources.cmake")
set(PipeLangModel_NATIVE_RUNTIME_SOURCE_DIRECTORY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pipelang-model/native-runtime")
set(PipeLangModel_NATIVE_RUNTIME_INCLUDE_DIRECTORY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
include("${CMAKE_CURRENT_LIST_DIR}/PipeLangModelRuntime.cmake")
_pipelang_model_runtime_contract(PipeLang::ModelRuntime "${PipeLangModel_MANIFEST_SHA256}" HEADER_ONLY "" "")
include("${CMAKE_CURRENT_LIST_DIR}/PipeLangModelBindings.cmake")
check_required_components(PipeLangModel)
