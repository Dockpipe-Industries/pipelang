@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Python3 3.9 COMPONENTS Interpreter)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/PipeLangModelTargets.cmake")
set(PipeLangModel_SDK_PREFIX "${PACKAGE_PREFIX_DIR}")
set(PipeLangModel_MODELC "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/pipelang-modelc@CMAKE_EXECUTABLE_SUFFIX@")
set(PipeLangModel_VIEWC "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/pipelang-model-viewc@CMAKE_EXECUTABLE_SUFFIX@")
set(PipeLangModel_GENERATOR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pipelang-model/tooling/generate_bindings.py")
set(PipeLangModel_MANIFEST "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pipelang-model/sdk-manifest.json")
if(NOT EXISTS "${PipeLangModel_MANIFEST}")
    message(FATAL_ERROR "PipeLangModel SDK manifest is missing")
endif()
file(SHA256 "${PipeLangModel_MANIFEST}" PipeLangModel_MANIFEST_SHA256)
include("${CMAKE_CURRENT_LIST_DIR}/PipeLangModelBindings.cmake")
check_required_components(PipeLangModel)
