include_guard(GLOBAL)

function(_pipelang_model_runtime_target target output)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "PipeLang runtime requires an existing target: ${target}")
    endif()
    get_target_property(aliased "${target}" ALIASED_TARGET)
    if(NOT "${aliased}" STREQUAL "aliased-NOTFOUND" AND NOT "${aliased}" STREQUAL "")
        set(target "${aliased}")
    endif()
    set("${output}" "${target}" PARENT_SCOPE)
endfunction()

# These properties describe registered link graphs, not arbitrary object files.
function(_pipelang_model_runtime_contract target sdk linkage profile owner)
    _pipelang_model_runtime_target("${target}" target)
    get_target_property(compatible "${target}" COMPATIBLE_INTERFACE_STRING)
    if(compatible STREQUAL "compatible-NOTFOUND")
        set(compatible)
    endif()
    foreach(key SDK LINKAGE PROFILE OWNER)
        string(TOLOWER "${key}" variable)
        set(value "${${variable}}")
        if(value STREQUAL "")
            continue()
        endif()
        set(property "PIPELANG_RUNTIME_${key}")
        get_target_property(existing "${target}" "INTERFACE_${property}")
        if(existing AND NOT existing STREQUAL value)
            message(FATAL_ERROR "PipeLang runtime contract conflict: ${property} on ${target}")
        endif()
        set_property(TARGET "${target}" PROPERTY "${property}" "${value}")
        set_property(TARGET "${target}" PROPERTY "INTERFACE_${property}" "${value}")
        list(APPEND compatible "${property}")
    endforeach()
    list(REMOVE_DUPLICATES compatible)
    set_property(TARGET "${target}" PROPERTY COMPATIBLE_INTERFACE_STRING "${compatible}")
endfunction()

function(_pipelang_model_runtime_policy_identity policy output)
    set(pending "${policy}")
    set(visited)
    set(identity)
    while(TRUE)
        list(LENGTH pending pending_count)
        if(pending_count EQUAL 0)
            break()
        endif()
        list(POP_FRONT pending node)
        _pipelang_model_runtime_target("${node}" node)
        if(node IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${node}")
        get_target_property(type "${node}" TYPE)
        if(NOT type STREQUAL "INTERFACE_LIBRARY")
            message(FATAL_ERROR "PipeLang linked runtime policy dependency must be an INTERFACE target: ${node}")
        endif()
        foreach(property LINK_LIBRARIES_DIRECT LINK_LIBRARIES_DIRECT_EXCLUDE SOURCES)
            get_target_property(value "${node}" "INTERFACE_${property}")
            if(NOT "${value}" STREQUAL "value-NOTFOUND" AND NOT "${value}" STREQUAL "")
                message(FATAL_ERROR "Unsupported linked runtime policy property: ${node} INTERFACE_${property}")
            endif()
        endforeach()
        foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS COMPILE_FEATURES
                INCLUDE_DIRECTORIES SYSTEM_INCLUDE_DIRECTORIES PRECOMPILE_HEADERS
                LINK_OPTIONS LINK_LIBRARIES LINK_DIRECTORIES POSITION_INDEPENDENT_CODE)
            get_target_property(value "${node}" "INTERFACE_${property}")
            if(value STREQUAL "value-NOTFOUND")
                set(value "")
            endif()
            # Configuration/language expressions remain declared policy data.
            # Target-dependent evaluation can hide another unvisited policy.
            if(value MATCHES "\\$<(TARGET_|GENEX_EVAL:)")
                message(FATAL_ERROR "Unsupported dynamic target reference in linked runtime policy: ${node} INTERFACE_${property}")
            endif()
            string(LENGTH "${node}.${property}" key_length)
            string(LENGTH "${value}" value_length)
            string(APPEND identity "\n${key_length}:${node}.${property}=${value_length}:${value}")
        endforeach()
        get_target_property(dependencies "${node}" INTERFACE_LINK_LIBRARIES)
        if(dependencies STREQUAL "dependencies-NOTFOUND")
            set(dependencies)
        endif()
        foreach(dependency IN LISTS dependencies)
            if(dependency STREQUAL "")
                continue()
            endif()
            if(dependency MATCHES "^\\$<BUILD_INTERFACE:([^$<>;]+)>$")
                set(dependency "${CMAKE_MATCH_1}")
            elseif(dependency MATCHES "^\\$<INSTALL_INTERFACE:[^$<>;]+>$")
                # The private producer policy is never exported by the runtime.
                continue()
            elseif(dependency MATCHES "\\$<")
                message(FATAL_ERROR "Unsupported dynamic linked runtime policy dependency: ${dependency}")
            endif()
            if(NOT TARGET "${dependency}")
                message(FATAL_ERROR "PipeLang linked runtime policy dependency must be a registered INTERFACE target: ${dependency}")
            endif()
            list(APPEND pending "${dependency}")
        endforeach()
    endwhile()
    set("${output}" "${identity}" PARENT_SCOPE)
endfunction()

function(_pipelang_model_linked_profile policy output)
    _pipelang_model_runtime_target("${policy}" policy)
    get_target_property(policy_type "${policy}" TYPE)
    if(NOT policy_type STREQUAL "INTERFACE_LIBRARY")
        message(FATAL_ERROR "PipeLang linked runtime POLICY_TARGET must be an INTERFACE target")
    endif()
    if(NOT PipeLangModel_MANIFEST_SHA256)
        message(FATAL_ERROR "PipeLang linked runtime requires an installed SDK manifest identity")
    endif()
    set(identity "sdk=${PipeLangModel_MANIFEST_SHA256};cxx=20;extensions=OFF;pic=ON;runtime=STATIC")
    set(variables
        CMAKE_CXX_COMPILER CMAKE_CXX_COMPILER_ID CMAKE_CXX_COMPILER_VERSION
        CMAKE_CXX_COMPILER_FRONTEND_VARIANT CMAKE_CXX_COMPILER_TARGET
        CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN CMAKE_CXX_SIMULATE_ID CMAKE_CXX_SIMULATE_VERSION
        CMAKE_CXX_COMPILER_ABI CMAKE_CXX_COMPILER_ARCHITECTURE_ID CMAKE_LIBRARY_ARCHITECTURE
        CMAKE_SYSTEM_NAME CMAKE_SYSTEM_VERSION CMAKE_SYSTEM_PROCESSOR CMAKE_SIZEOF_VOID_P
        CMAKE_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_SYSROOT
        CMAKE_CXX_STANDARD CMAKE_CXX_STANDARD_REQUIRED CMAKE_CXX_EXTENSIONS
        CMAKE_INTERPROCEDURAL_OPTIMIZATION CMAKE_GENERATOR_PLATFORM CMAKE_VS_PLATFORM_TOOLSET
        CMAKE_MSVC_RUNTIME_LIBRARY CMAKE_CXX_STANDARD_LIBRARIES CMAKE_CXX_IMPLICIT_LINK_LIBRARIES
        CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS CMAKE_STATIC_LINKER_FLAGS
        CMAKE_BUILD_TYPE CMAKE_CONFIGURATION_TYPES)
    set(configurations DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    foreach(configuration IN LISTS CMAKE_CONFIGURATION_TYPES)
        string(TOUPPER "${configuration}" configuration)
        list(APPEND configurations "${configuration}")
    endforeach()
    if(CMAKE_BUILD_TYPE)
        string(TOUPPER "${CMAKE_BUILD_TYPE}" configuration)
        list(APPEND configurations "${configuration}")
    endif()
    list(REMOVE_DUPLICATES configurations)
    list(SORT configurations)
    foreach(configuration IN LISTS configurations)
        list(APPEND variables "CMAKE_CXX_FLAGS_${configuration}"
            "CMAKE_EXE_LINKER_FLAGS_${configuration}" "CMAKE_STATIC_LINKER_FLAGS_${configuration}"
            "CMAKE_INTERPROCEDURAL_OPTIMIZATION_${configuration}")
    endforeach()
    foreach(variable IN LISTS variables)
        string(LENGTH "${${variable}}" length)
        string(APPEND identity "\n${variable}=${length}:${${variable}}")
    endforeach()
    foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS LINK_OPTIONS INCLUDE_DIRECTORIES)
        get_directory_property(value "${property}")
        string(LENGTH "${value}" length)
        string(APPEND identity "\ndirectory.${property}=${length}:${value}")
    endforeach()
    _pipelang_model_runtime_policy_identity("${policy}" policy_identity)
    string(LENGTH "${policy_identity}" policy_length)
    string(APPEND identity "\npolicy=${policy_length}:${policy_identity}")
    _pipelang_model_resolve_cxx_resource_profile(resource_profile resource_response resource_digest resource_dependency)
    string(APPEND identity "\nresource=${resource_profile}:${resource_digest}")
    string(SHA256 digest "${identity}")
    set("${output}" "${digest}" PARENT_SCOPE)
endfunction()

function(_pipelang_model_validate_linked_runtime target output)
    _pipelang_model_runtime_target("${target}" runtime)
    get_target_property(managed "${runtime}" PIPELANG_LINKED_RUNTIME)
    get_target_property(imported "${runtime}" IMPORTED)
    get_target_property(type "${runtime}" TYPE)
    if(NOT managed OR imported OR NOT type STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "RUNTIME_TARGET must be a local STATIC target from pipelang_add_linked_runtime")
    endif()
    get_target_property(sdk "${runtime}" INTERFACE_PIPELANG_RUNTIME_SDK)
    if(NOT sdk STREQUAL PipeLangModel_MANIFEST_SHA256)
        message(FATAL_ERROR "PipeLang runtime contract conflict: PIPELANG_RUNTIME_SDK on ${runtime}")
    endif()
    get_target_property(policy "${runtime}" PIPELANG_RUNTIME_POLICY_TARGET)
    get_target_property(expected "${runtime}" INTERFACE_PIPELANG_RUNTIME_PROFILE)
    _pipelang_model_linked_profile("${policy}" actual)
    if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "PipeLang linked runtime policy/profile changed after declaration: ${runtime}")
    endif()
    set("${output}" "${runtime}" PARENT_SCOPE)
endfunction()

function(pipelang_add_linked_runtime target)
    cmake_parse_arguments(PARSE_ARGV 1 runtime "" "POLICY_TARGET" "")
    if(runtime_UNPARSED_ARGUMENTS OR runtime_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "pipelang_add_linked_runtime received unexpected or incomplete arguments")
    endif()
    if("${runtime_POLICY_TARGET}" STREQUAL "")
        message(FATAL_ERROR "PipeLang linked runtime requires POLICY_TARGET")
    endif()
    if(TARGET "${target}")
        message(FATAL_ERROR "PipeLang linked runtime target already exists: ${target}")
    endif()
    _pipelang_model_runtime_target("${runtime_POLICY_TARGET}" policy)
    _pipelang_model_linked_profile("${policy}" profile)
    set(sources)
    foreach(name task_scope.cpp object_domain.cpp)
        set(source "${PipeLangModel_NATIVE_RUNTIME_SOURCE_DIRECTORY}/${name}")
        if(NOT IS_ABSOLUTE "${source}" OR NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
            message(FATAL_ERROR "PipeLang SDK linked runtime source is missing: ${source}")
        endif()
        list(APPEND sources "${source}")
    endforeach()
    if(NOT IS_DIRECTORY "${PipeLangModel_NATIVE_RUNTIME_INCLUDE_DIRECTORY}/pipelang/model")
        message(FATAL_ERROR "PipeLang SDK linked runtime include directory is missing")
    endif()
    # A runtime-only consumer does not run a model-generation command, so it
    # must admit the SDK payload itself before compiling installed sources.
    file(GLOB_RECURSE runtime_headers CONFIGURE_DEPENDS LIST_DIRECTORIES false
        "${PipeLangModel_NATIVE_RUNTIME_INCLUDE_DIRECTORY}/pipelang/*.hpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PipeLangModel_MANIFEST}" "${PipeLangModel_GENERATOR}" ${sources} ${runtime_headers})
    execute_process(
        COMMAND "${PipeLangModel_GENERATOR}" verify
            --prefix "${PipeLangModel_SDK_PREFIX}"
            --manifest "${PipeLangModel_MANIFEST}"
            --sha256 "${PipeLangModel_MANIFEST_SHA256}"
        TIMEOUT 90
        RESULT_VARIABLE verification_status
        OUTPUT_VARIABLE verification_output
        ERROR_VARIABLE verification_error)
    if(NOT "${verification_status}" STREQUAL "0")
        message(FATAL_ERROR "PipeLang linked runtime SDK verification failed: ${verification_status}\n${verification_output}${verification_error}")
    endif()
    add_library("${target}" STATIC ${sources})
    set_target_properties("${target}" PROPERTIES
        POSITION_INDEPENDENT_CODE ON CXX_EXTENSIONS OFF UNITY_BUILD OFF
        PIPELANG_LINKED_RUNTIME TRUE PIPELANG_RUNTIME_POLICY_TARGET "${policy}")
    target_compile_features("${target}" PRIVATE cxx_std_20)
    target_compile_features("${target}" INTERFACE "$<BUILD_INTERFACE:cxx_std_20>")
    target_include_directories("${target}" PUBLIC
        "$<BUILD_INTERFACE:${PipeLangModel_NATIVE_RUNTIME_INCLUDE_DIRECTORY}>")
    target_compile_definitions("${target}" PUBLIC "$<BUILD_INTERFACE:PIPELANG_MODEL_LINKED_RUNTIME=1>")
    target_link_libraries("${target}" PUBLIC "$<BUILD_INTERFACE:${policy}>" Threads::Threads)
    _pipelang_model_resolve_cxx_resource_profile(resource_profile resource_response resource_digest resource_dependency)
    _pipelang_model_apply_cxx_resource_profile("${target}"
        "${resource_profile}" "${resource_response}" "${resource_digest}")
    if(resource_profile STREQUAL "gnu-conservative-gc")
        target_compile_options("${target}" PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:@${resource_response}>")
    endif()
    string(SHA256 owner "${PipeLangModel_MANIFEST_SHA256};${CMAKE_BINARY_DIR};${target}")
    _pipelang_model_runtime_contract("${target}" "${PipeLangModel_MANIFEST_SHA256}" LINKED "${profile}" "${owner}")
endfunction()

function(_pipelang_model_install_linked_runtime runtime owner export_name archive_destination)
    _pipelang_model_validate_linked_runtime("${runtime}" runtime)
    get_target_property(existing_export "${runtime}" PIPELANG_INSTALL_EXPORT)
    get_target_property(existing_destination "${runtime}" PIPELANG_INSTALL_DESTINATION)
    if(existing_export)
        if(NOT existing_export STREQUAL export_name OR NOT existing_destination STREQUAL archive_destination)
            message(FATAL_ERROR "PipeLang runtime archive already belongs to a different installation")
        endif()
    else()
        install(TARGETS "${runtime}" EXPORT "${export_name}" ARCHIVE DESTINATION "${archive_destination}")
        set_property(TARGET "${runtime}" PROPERTY PIPELANG_INSTALL_EXPORT "${export_name}")
        set_property(TARGET "${runtime}" PROPERTY PIPELANG_INSTALL_DESTINATION "${archive_destination}")
    endif()
    get_target_property(sdk "${runtime}" INTERFACE_PIPELANG_RUNTIME_SDK)
    get_target_property(profile "${runtime}" INTERFACE_PIPELANG_RUNTIME_PROFILE)
    get_target_property(runtime_owner "${runtime}" INTERFACE_PIPELANG_RUNTIME_OWNER)
    _pipelang_model_runtime_contract("${owner}" "${sdk}" LINKED "${profile}" "${runtime_owner}")
    get_target_property(existing_owners "${runtime}" PIPELANG_INSTALL_OWNERS)
    if(NOT owner IN_LIST existing_owners)
        target_link_libraries("${owner}" PRIVATE "$<INSTALL_INTERFACE:${runtime}>")
        set_property(TARGET "${runtime}" APPEND PROPERTY PIPELANG_INSTALL_OWNERS "${owner}")
    endif()
endfunction()
