function(pipelang_add_native_executable target)
    cmake_parse_arguments(PARSE_ARGV 1 app "SOURCE_TRACE"
        "SOURCE;SOURCE_SET;PROJECT_ROOT;PROJECT_ENTRY;SOURCE_ROOT;SOURCE_LIBRARIES;ENTRY;OUTPUT;TARGET;PROFILE;NATIVE_NUMERIC_ENVIRONMENT;OBJECT_COMPILER;PROJECT_TOOL;LLC;LINKER;LINK_SDK;LINK_SDK_SHA256;PDB;MACOS_SYSROOT;MACOS_SDK_VERSION;DSYMUTIL" "")
    _pipelang_add_native_artifact("${target}" executable pipelang_add_native_executable)
endfunction()

function(pipelang_add_native_object target)
    cmake_parse_arguments(PARSE_ARGV 1 app "HOST_SNAPSHOT;HOST_MULTIPLE_TASKS;HOST_OBJECT_REFERENCES"
        "SOURCE;MODEL;SOURCE_SET;PROJECT_ROOT;PROJECT_ENTRY;SOURCE_ROOT;SOURCE_LIBRARIES;ENTRY;OUTPUT;TARGET;PROFILE;NATIVE_NUMERIC_ENVIRONMENT;OBJECT_COMPILER;PROJECT_TOOL;LLC;LINK_SDK;LINK_SDK_SHA256;HOST_SYMBOL;HOST_CONSTRUCTOR;HOST_COMPOSITION;NUMERIC_SYMBOL"
        "HOST_METHODS;MODEL_EXPORTS")
    _pipelang_add_native_artifact("${target}" object pipelang_add_native_object)
endfunction()

function(_pipelang_add_native_artifact target kind caller)
    if(app_UNPARSED_ARGUMENTS OR app_KEYWORDS_MISSING_VALUES OR TARGET "${target}")
        message(FATAL_ERROR "Invalid arguments or existing target for ${caller}: ${target}")
    endif()
    foreach(option ENTRY OUTPUT TARGET LLC LINK_SDK LINK_SDK_SHA256)
        if(NOT app_${option})
            message(FATAL_ERROR "${caller} requires ${option}")
        endif()
    endforeach()
    foreach(option LLC LINK_SDK)
        if(NOT IS_ABSOLUTE "${app_${option}}")
            message(FATAL_ERROR "${caller} requires an absolute ${option}")
        endif()
    endforeach()
    if(kind STREQUAL "executable" AND NOT app_LINKER)
        message(FATAL_ERROR "${caller} requires LINKER")
    elseif(kind STREQUAL "executable" AND NOT IS_ABSOLUTE "${app_LINKER}")
        message(FATAL_ERROR "${caller} requires an absolute LINKER")
    elseif(kind STREQUAL "object" AND NOT app_HOST_SYMBOL AND
            (app_HOST_METHODS OR app_HOST_SNAPSHOT OR app_HOST_MULTIPLE_TASKS OR app_HOST_OBJECT_REFERENCES OR
             app_HOST_CONSTRUCTOR OR app_HOST_COMPOSITION))
        message(FATAL_ERROR "Hosted object options require HOST_SYMBOL")
    endif()
    if(NOT app_PROFILE)
        set(app_PROFILE debug)
    endif()
    if(NOT app_OBJECT_COMPILER)
        set(app_OBJECT_COMPILER "${app_LINK_SDK}/pipelang-objectc")
        if(CMAKE_HOST_WIN32)
            string(APPEND app_OBJECT_COMPILER ".exe")
        endif()
        if(NOT EXISTS "${app_OBJECT_COMPILER}" AND PipeLangModel_OBJECTC)
            set(app_OBJECT_COMPILER "${PipeLangModel_OBJECTC}")
        endif()
        if(NOT EXISTS "${app_OBJECT_COMPILER}")
            message(FATAL_ERROR "${caller} requires a native object compiler in PipeLangModel or LINK_SDK, or an explicit OBJECT_COMPILER")
        endif()
    endif()
    if(NOT IS_ABSOLUTE "${app_OBJECT_COMPILER}")
        message(FATAL_ERROR "${caller} requires an absolute OBJECT_COMPILER")
    endif()

    set(manifest "${app_LINK_SDK}/link-sdk.json")
    file(SHA256 "${manifest}" actual_sdk_digest)
    if(NOT actual_sdk_digest STREQUAL app_LINK_SDK_SHA256)
        message(FATAL_ERROR "Native ${kind} link SDK manifest SHA-256 mismatch")
    endif()
    file(READ "${manifest}" sdk_information)
    set(dependencies "${manifest}" "${app_OBJECT_COMPILER}" "${app_LLC}")
    if(kind STREQUAL "executable")
        list(APPEND dependencies "${app_LINKER}")
    endif()
    string(JSON file_count LENGTH "${sdk_information}" files)
    if(file_count LESS 1)
        message(FATAL_ERROR "Native ${kind} link SDK manifest has no files")
    endif()
    math(EXPR last_file "${file_count} - 1")
    foreach(index RANGE 0 "${last_file}")
        string(JSON file GET "${sdk_information}" files "${index}" path)
        list(APPEND dependencies "${app_LINK_SDK}/${file}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")

    set(input_count 0)
    foreach(input SOURCE MODEL SOURCE_SET PROJECT_ROOT)
        if(app_${input})
            math(EXPR input_count "${input_count} + 1")
        endif()
    endforeach()
    if(NOT input_count EQUAL 1)
        message(FATAL_ERROR "Select exactly one SOURCE, MODEL, SOURCE_SET or PROJECT_ROOT for a native ${kind}")
    endif()

    if(app_MODEL_EXPORTS AND NOT app_MODEL)
        message(FATAL_ERROR "MODEL_EXPORTS requires MODEL")
    endif()

    set(project_info)
    if(app_SOURCE)
        if(app_PROJECT_ENTRY OR app_SOURCE_ROOT OR app_SOURCE_LIBRARIES OR
                (kind STREQUAL "executable" AND app_PROJECT_TOOL))
            message(FATAL_ERROR "Native build project arguments require PROJECT_ROOT")
        endif()
        get_filename_component(source "${app_SOURCE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set(source_arguments --source "${source}")
        list(APPEND dependencies "${source}")
    elseif(app_MODEL)
        if(app_PROJECT_ENTRY OR app_SOURCE_ROOT OR app_SOURCE_LIBRARIES OR app_HOST_COMPOSITION OR NOT app_HOST_SYMBOL)
            message(FATAL_ERROR "MODEL requires HOST_SYMBOL and its own single source file")
        endif()
        get_filename_component(model_source "${app_MODEL}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set(source_arguments --model "${model_source}")
        foreach(model_export IN LISTS app_MODEL_EXPORTS)
            list(APPEND source_arguments --model-export "${model_export}")
        endforeach()
        list(APPEND dependencies "${model_source}")
    elseif(app_SOURCE_SET)
        if(app_PROJECT_ENTRY OR app_SOURCE_ROOT OR app_SOURCE_LIBRARIES OR app_HOST_COMPOSITION)
            message(FATAL_ERROR "SOURCE_SET uses its own entry and module list. Project arguments require PROJECT_ROOT")
        endif()
        if(NOT app_PROJECT_TOOL)
            set(app_PROJECT_TOOL "${PipeLangModel_GENERATOR}")
        endif()
        if(NOT IS_ABSOLUTE "${app_PROJECT_TOOL}")
            message(FATAL_ERROR "Native SOURCE_SET requires an absolute PROJECT_TOOL")
        endif()
        get_filename_component(source_set "${app_SOURCE_SET}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set(source_arguments --source-set "${source_set}")
        execute_process(COMMAND "${app_PROJECT_TOOL}" source-set-info
            --sdk-prefix "${app_LINK_SDK}" --sdk-manifest "${manifest}" --sdk-manifest-sha256 "${app_LINK_SDK_SHA256}"
            --source-set "${source_set}"
            RESULT_VARIABLE result OUTPUT_VARIABLE source_set_info ERROR_VARIABLE problem)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "PipeLang native source-set admission failed: ${problem}")
        endif()
        string(JSON source_set_protocol GET "${source_set_info}" protocol)
        if(NOT source_set_protocol STREQUAL "pipelang.native-model-source-set-info.v1")
            message(FATAL_ERROR "PipeLang native source-set information protocol mismatch")
        endif()
        string(JSON count LENGTH "${source_set_info}" dependencies)
        if(count LESS 2)
            message(FATAL_ERROR "PipeLang native source set has no modules")
        endif()
        math(EXPR last "${count} - 1")
        set(source_set_dependencies "${app_PROJECT_TOOL}")
        foreach(index RANGE 0 "${last}")
            string(JSON file GET "${source_set_info}" dependencies "${index}")
            list(APPEND source_set_dependencies "${file}")
        endforeach()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${source_set_dependencies})
        list(APPEND dependencies ${source_set_dependencies})
    else()
        if(NOT app_PROJECT_TOOL)
            set(app_PROJECT_TOOL "${PipeLangModel_GENERATOR}")
        endif()
        if(NOT app_PROJECT_ENTRY OR NOT IS_ABSOLUTE "${app_PROJECT_TOOL}")
            message(FATAL_ERROR "Native build projects require PROJECT_ENTRY and an absolute PROJECT_TOOL")
        endif()
        if(NOT app_SOURCE_ROOT)
            set(app_SOURCE_ROOT src)
        endif()
        get_filename_component(project_root "${app_PROJECT_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set(project_arguments --project-root "${project_root}" --source-root "${app_SOURCE_ROOT}")
        if(app_SOURCE_LIBRARIES)
            get_filename_component(libraries "${app_SOURCE_LIBRARIES}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
            list(APPEND project_arguments --source-libraries "${libraries}")
        endif()
        set(source_arguments ${project_arguments} --project-entry "${app_PROJECT_ENTRY}")
        execute_process(COMMAND "${app_PROJECT_TOOL}" project-info
            --sdk-prefix "${app_LINK_SDK}" --sdk-manifest "${manifest}" --sdk-manifest-sha256 "${app_LINK_SDK_SHA256}"
            ${project_arguments} --entry "${app_PROJECT_ENTRY}"
            RESULT_VARIABLE result OUTPUT_VARIABLE project_info ERROR_VARIABLE problem)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "PipeLang native project admission failed: ${problem}")
        endif()
        string(JSON project_protocol GET "${project_info}" protocol)
        if(NOT project_protocol STREQUAL "pipelang.native-model-project-info.v1")
            message(FATAL_ERROR "PipeLang native project information protocol mismatch")
        endif()
        string(JSON count LENGTH "${project_info}" dependencies)
        if(count LESS 1)
            message(FATAL_ERROR "PipeLang native project has no dependencies")
        endif()
        math(EXPR last "${count} - 1")
        set(project_dependencies "${app_PROJECT_TOOL}")
        foreach(index RANGE 0 "${last}")
            string(JSON file GET "${project_info}" dependencies "${index}")
            list(APPEND project_dependencies "${file}")
        endforeach()
        file(GLOB_RECURSE project_membership CONFIGURE_DEPENDS LIST_DIRECTORIES false
            "${project_root}/${app_SOURCE_ROOT}/*.pipe")
        if(app_SOURCE_LIBRARIES)
            string(JSON count LENGTH "${project_info}" source_directories)
            if(count GREATER 0)
                math(EXPR last "${count} - 1")
                foreach(index RANGE 0 "${last}")
                    string(JSON directory GET "${project_info}" source_directories "${index}")
                    file(GLOB_RECURSE library_membership CONFIGURE_DEPENDS LIST_DIRECTORIES false "${directory}/*.pipe")
                endforeach()
            endif()
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${project_dependencies})
        list(APPEND dependencies ${project_dependencies})
    endif()

    get_filename_component(output "${app_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    get_filename_component(output_directory "${output}" DIRECTORY)
    set(options)
    if(DEFINED app_NATIVE_NUMERIC_ENVIRONMENT)
        if(NOT "${app_NATIVE_NUMERIC_ENVIRONMENT}" STREQUAL "active-host")
            message(FATAL_ERROR "NATIVE_NUMERIC_ENVIRONMENT must be active-host when specified")
        endif()
        list(APPEND options --native-numeric-environment active-host)
    endif()
    if(DEFINED app_NUMERIC_SYMBOL)
        if(DEFINED app_HOST_SYMBOL OR NOT "${app_NATIVE_NUMERIC_ENVIRONMENT}" STREQUAL "active-host")
            message(FATAL_ERROR "NUMERIC_SYMBOL requires a separate active-host numeric object")
        endif()
        list(APPEND options --numeric-symbol "${app_NUMERIC_SYMBOL}")
    endif()
    set(symbols)
    set(symbol_directory)
    set(admit_sdk)
    if(kind STREQUAL "object")
        if(NOT app_PROJECT_TOOL)
            set(app_PROJECT_TOOL "${PipeLangModel_GENERATOR}")
        endif()
        if(NOT IS_ABSOLUTE "${app_PROJECT_TOOL}")
            message(FATAL_ERROR "${caller} requires an absolute PROJECT_TOOL or the installed PipeLangModel package")
        endif()
        set(admit_sdk COMMAND "${app_PROJECT_TOOL}" verify --prefix "${app_LINK_SDK}"
            --manifest "${manifest}" --sha256 "${app_LINK_SDK_SHA256}")
        list(APPEND dependencies "${app_PROJECT_TOOL}")
        if(app_HOST_SYMBOL)
            list(APPEND options --host-symbol "${app_HOST_SYMBOL}")
        endif()
        if(app_HOST_CONSTRUCTOR)
            list(APPEND options --host-constructor "${app_HOST_CONSTRUCTOR}")
        endif()
        if(app_HOST_COMPOSITION)
            if(NOT app_HOST_OBJECT_REFERENCES)
                message(FATAL_ERROR "HOST_COMPOSITION requires HOST_OBJECT_REFERENCES")
            endif()
            list(APPEND options --host-composition "${app_HOST_COMPOSITION}")
        endif()
        if(app_HOST_SNAPSHOT)
            list(APPEND options --host-snapshot)
        endif()
        if(app_HOST_MULTIPLE_TASKS)
            list(APPEND options --host-multiple-tasks)
        endif()
        if(app_HOST_OBJECT_REFERENCES)
            list(APPEND options --host-object-references)
        endif()
        foreach(method IN LISTS app_HOST_METHODS)
            list(APPEND options --host-method "${method}")
        endforeach()
        set(command "${app_OBJECT_COMPILER}" ${source_arguments} --entry "${app_ENTRY}"
            --target "${app_TARGET}" --profile "${app_PROFILE}" --llc "${app_LLC}" --output "${output}" ${options})
    else()
        _pipelang_native_executable_command(command symbols symbol_directory dependencies)
    endif()
    string(SHA256 input_identity "${project_info};${command}")
    set(input_stamp "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${target}.pipelang-native-inputs")
    file(CONFIGURE OUTPUT "${input_stamp}" CONTENT "${input_identity}\n")
    # CMake can remove the first output when a generated command changes.
    # Keep the published application and debug files available until compilation succeeds.
    set(completion_stamp "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${target}.pipelang-native-complete")
    add_custom_command(OUTPUT "${completion_stamp}" "${output}" ${symbols}
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${output_directory}" ${symbol_directory}
        ${admit_sdk}
        COMMAND ${command}
        COMMAND "${CMAKE_COMMAND}" -E touch "${completion_stamp}"
        DEPENDS ${dependencies} "${input_stamp}" VERBATIM
        COMMENT "Compile PipeLang native ${kind} ${target}")
    add_custom_target("${target}" ALL DEPENDS "${completion_stamp}" "${output}" ${symbols})
    if(kind STREQUAL "object")
        set_source_files_properties("${output}" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
        set_property(TARGET "${target}" PROPERTY PIPELANG_NATIVE_OBJECT "${output}")
    endif()
endfunction()

function(_pipelang_native_executable_command out_command out_symbols out_symbol_directory out_dependencies)
    if(app_SOURCE_TRACE)
        list(APPEND options --source-trace)
    endif()
    if(app_TARGET MATCHES "^windows-" OR (app_TARGET STREQUAL "host" AND CMAKE_HOST_WIN32))
        if(NOT output MATCHES "[.]exe$")
            message(FATAL_ERROR "Windows native executable output must end in .exe")
        endif()
        if(app_PDB)
            get_filename_component(pdb "${app_PDB}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        else()
            string(REGEX REPLACE "[.]exe$" ".pdb" pdb "${output}")
        endif()
        get_filename_component(symbol_directory "${pdb}" DIRECTORY)
        list(APPEND options --pdb "${pdb}")
        list(APPEND symbols "${pdb}")
    elseif(app_PDB)
        message(FATAL_ERROR "PDB requires a Windows native target")
    endif()
    if(app_TARGET MATCHES "^macos-" OR (app_TARGET STREQUAL "host" AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin"))
        foreach(option MACOS_SYSROOT MACOS_SDK_VERSION DSYMUTIL)
            if(NOT app_${option})
                message(FATAL_ERROR "A macOS native executable requires ${option}")
            endif()
        endforeach()
        list(APPEND options --macos-sysroot "${app_MACOS_SYSROOT}" --macos-sdk-version "${app_MACOS_SDK_VERSION}"
            --dsymutil "${app_DSYMUTIL}")
        get_filename_component(executable_name "${output}" NAME)
        list(APPEND symbols "${output}.dSYM/Contents/Info.plist"
            "${output}.dSYM/Contents/Resources/DWARF/${executable_name}")
        list(APPEND dependencies "${app_DSYMUTIL}" "${app_MACOS_SYSROOT}/usr/lib/libSystem.tbd"
            "${app_MACOS_SYSROOT}/usr/lib/libc++.tbd")
    elseif(app_MACOS_SYSROOT OR app_MACOS_SDK_VERSION OR app_DSYMUTIL)
        message(FATAL_ERROR "macOS SDK arguments require a macOS native target")
    endif()
    set(command "${app_OBJECT_COMPILER}" ${source_arguments} --entry "${app_ENTRY}" --executable
        --target "${app_TARGET}" --profile "${app_PROFILE}" --llc "${app_LLC}" --linker "${app_LINKER}"
        --link-sdk "${app_LINK_SDK}" --link-sdk-sha256 "${app_LINK_SDK_SHA256}" --output "${output}" ${options})
    set("${out_command}" "${command}" PARENT_SCOPE)
    set("${out_symbols}" "${symbols}" PARENT_SCOPE)
    set("${out_symbol_directory}" "${symbol_directory}" PARENT_SCOPE)
    set("${out_dependencies}" "${dependencies}" PARENT_SCOPE)
endfunction()
