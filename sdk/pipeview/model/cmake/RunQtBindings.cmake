foreach(input BINDING_COMPILER BINDING_COMPILER_SHA256 MODEL_MANIFEST SOURCE_MODEL ADAPTER_NAMESPACE ADAPTER OUTPUT_HEADER OUTPUT_RECEIPT)
    if(NOT DEFINED ${input})
        message(FATAL_ERROR "Missing Qt binding input ${input}")
    endif()
endforeach()
file(SHA256 "${BINDING_COMPILER}" tool_hash)
if(NOT tool_hash STREQUAL BINDING_COMPILER_SHA256)
    message(FATAL_ERROR "Qt binding compiler changed")
endif()
file(SHA256 "${MODEL_MANIFEST}" model_hash)
execute_process(COMMAND "${BINDING_COMPILER}" --manifest "${MODEL_MANIFEST}"
    --model "${SOURCE_MODEL}" --namespace "${ADAPTER_NAMESPACE}" --adapter "${ADAPTER}"
    RESULT_VARIABLE outcome OUTPUT_VARIABLE header ERROR_VARIABLE failure TIMEOUT 30)
if(NOT outcome EQUAL 0)
    message(FATAL_ERROR "Qt binding generation refused: ${failure}")
endif()
file(SHA256 "${MODEL_MANIFEST}" model_after)
file(SHA256 "${BINDING_COMPILER}" tool_after)
if(NOT model_hash STREQUAL model_after OR NOT tool_hash STREQUAL tool_after)
    message(FATAL_ERROR "Qt binding input changed during generation")
endif()
get_filename_component(directory "${OUTPUT_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT_HEADER}.tmp" "${header}")
file(SHA256 "${OUTPUT_HEADER}.tmp" header_hash)
set(receipt "{}")
string(JSON receipt SET "${receipt}" protocol "\"pipelang.qt-binding-receipt.v1\"")
string(JSON receipt SET "${receipt}" model_manifest_sha256 "\"${model_hash}\"")
string(JSON receipt SET "${receipt}" compiler_sha256 "\"${tool_hash}\"")
string(JSON receipt SET "${receipt}" header_sha256 "\"${header_hash}\"")
file(WRITE "${OUTPUT_RECEIPT}.tmp" "${receipt}\n")
file(RENAME "${OUTPUT_HEADER}.tmp" "${OUTPUT_HEADER}")
file(RENAME "${OUTPUT_RECEIPT}.tmp" "${OUTPUT_RECEIPT}")
