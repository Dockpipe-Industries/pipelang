cmake_minimum_required(VERSION 3.21.1)

# Run as one unit in the existing native containment workflow. This script uses
# only CMake, the exact installed SDK and the selected native C++ compiler.
foreach(argument SDK_PREFIX SOURCE_ROOT OUTPUT_ROOT CXX_COMPILER)
    if(NOT DEFINED ${argument} OR NOT IS_ABSOLUTE "${${argument}}")
        message(FATAL_ERROR "${argument} must be an absolute path")
    endif()
endforeach()
if(EXISTS "${OUTPUT_ROOT}")
    message(FATAL_ERROR "Compile-resource contracts require a fresh output root")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(fixture "${SOURCE_ROOT}/tests/compile-resource-profile")
set(relocated "${OUTPUT_ROOT}/relocated sdk")
file(COPY "${SDK_PREFIX}/" DESTINATION "${relocated}")
set(manifest "${relocated}/share/pipelang-model/sdk-manifest.json")
file(SHA256 "${manifest}" manifest_sha256)
if(CMAKE_HOST_WIN32)
    set(executable_suffix .exe)
else()
    set(executable_suffix "")
endif()
set(sdk_tool "${relocated}/bin/pipelang-sdk-tool${executable_suffix}")
get_filename_component(cmake_directory "${CMAKE_COMMAND}" DIRECTORY)
find_program(ctest_command NAMES ctest HINTS "${cmake_directory}" REQUIRED)

function(run name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
    file(WRITE "${OUTPUT_ROOT}/${name}.output" "${output}${error}")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${name} failed: ${result}\n${output}${error}")
    endif()
endfunction()

run(relocated-sdk-verify "${sdk_tool}" verify --prefix "${relocated}"
    --manifest "${manifest}" --sha256 "${manifest_sha256}")
set(profile_path "share/pipelang-model/compiler-profiles/gnu-conservative-gc.rsp")
set(canonical "${relocated}/${profile_path}")
file(READ "${canonical}" canonical_bytes)
if(NOT canonical_bytes STREQUAL "--param=ggc-min-expand=10\n--param=ggc-min-heapsize=4096\n")
    message(FATAL_ERROR "GNU profile must contain only the two qualified GC parameters")
endif()
file(SHA256 "${canonical}" canonical_sha256)
file(READ "${manifest}" manifest_json)
string(JSON manifest_count LENGTH "${manifest_json}" files)
math(EXPR manifest_last "${manifest_count} - 1")
set(profile_in_manifest FALSE)
foreach(index RANGE 0 ${manifest_last})
    string(JSON path GET "${manifest_json}" files ${index} path)
    if(path STREQUAL "share/pipelang-model/compiler-profiles/gnu-conservative-gc.rsp")
        string(JSON recorded_sha256 GET "${manifest_json}" files ${index} sha256)
        if(NOT recorded_sha256 STREQUAL canonical_sha256)
            message(FATAL_ERROR "Installed GNU profile differs from its manifest identity")
        endif()
        set(profile_in_manifest TRUE)
        break()
    endif()
endforeach()
if(NOT profile_in_manifest)
    message(FATAL_ERROR "Installed GNU profile is outside the SDK manifest")
endif()

function(configure name environment override expected)
    set(build "${OUTPUT_ROOT}/${name} build")
    set(command "${CMAKE_COMMAND}" -E env)
    if(environment STREQUAL "unset")
        list(APPEND command --unset=PIPELANG_CXX_RESOURCE_PROFILE)
    else()
        list(APPEND command "PIPELANG_CXX_RESOURCE_PROFILE=${environment}")
    endif()
    list(APPEND command "${CMAKE_COMMAND}" -S "${fixture}" -B "${build}"
        "-DCMAKE_PREFIX_PATH=${relocated}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
    if(DEFINED GENERATOR AND NOT GENERATOR STREQUAL "")
        list(APPEND command -G "${GENERATOR}")
    elseif(CMAKE_HOST_WIN32)
        list(APPEND command -G Ninja)
    endif()
    if(NOT override STREQUAL "unset")
        list(APPEND command "-DPipeLangModel_CXX_RESOURCE_PROFILE:STRING=${override}")
    endif()
    list(APPEND command ${ARGN})
    execute_process(COMMAND ${command} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
    file(WRITE "${OUTPUT_ROOT}/${name}-configure.output" "${output}${error}")
    if(expected STREQUAL "success")
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "${name} configure failed: ${output}${error}")
        endif()
    else()
        string(FIND "${output}${error}" "${expected}" diagnostic)
        if("${result}" STREQUAL "0" OR diagnostic EQUAL -1)
            message(FATAL_ERROR "${name} did not refuse with ${expected}: ${output}${error}")
        endif()
    endif()
endfunction()

function(verify_commands build expected_profile)
    file(READ "${build}/profile-policy.json" policy)
    string(JSON profile GET "${policy}" profile)
    string(JSON response GET "${policy}" response)
    if(NOT profile STREQUAL expected_profile)
        message(FATAL_ERROR "Wrong CXX profile selected in ${build}: ${profile}")
    endif()
    file(READ "${build}/compile_commands.json" commands)
    string(JSON count LENGTH "${commands}")
    math(EXPR last "${count} - 1")
    set(consumers 0)
    set(producers 0)
    set(owners 0)
    set(precompiled_headers 0)
    file(STRINGS "${build}/implementation-sources.txt" expected_implementations)
    if(NOT expected_implementations)
        message(FATAL_ERROR "Compiled fixture has no canonical owned implementation inventory")
    endif()
    string(REPLACE "\\" "/" expected_implementations "${expected_implementations}")
    set(seen_implementations)
    foreach(index RANGE 0 ${last})
        string(JSON directory GET "${commands}" ${index} directory)
        string(JSON source GET "${commands}" ${index} file)
        string(REPLACE "\\" "/" directory "${directory}")
        string(REPLACE "\\" "/" source "${source}")
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${directory}")
        string(JSON command GET "${commands}" ${index} command)
        if(expected_profile STREQUAL "system")
            if(command MATCHES "compiler-profiles|ggc-min-")
                message(FATAL_ERROR "System profile acquired GNU GC options")
            endif()
        else()
            string(FIND "${command}" "@${response}" option)
            if(option EQUAL -1)
                message(FATAL_ERROR "Selected policy missing from ${source}: ${command}")
            endif()
            if(command MATCHES "--param=ggc-min-")
                message(FATAL_ERROR "GC flag constants were duplicated outside the canonical response file")
            endif()
        endif()
        if(source MATCHES "Implementation_[0-9]+[.]cpp$")
            math(EXPR producers "${producers} + 1")
            list(APPEND seen_implementations "${source}")
        elseif(source MATCHES "/Unity/unity_[0-9]+_cxx[.]cxx$")
            file(STRINGS "${source}" includes REGEX "^#include \"")
            set(members 0)
            get_filename_component(unity_directory "${source}" DIRECTORY)
            foreach(include_line IN LISTS includes)
                if(NOT include_line MATCHES "^#include \"([^\"]+)\"$")
                    message(FATAL_ERROR "Malformed generated unity include")
                endif()
                string(REPLACE "\\" "/" member "${CMAKE_MATCH_1}")
                get_filename_component(member "${member}" ABSOLUTE BASE_DIR "${unity_directory}")
                if(NOT member IN_LIST expected_implementations)
                    message(FATAL_ERROR "Unity batch included an unowned implementation: ${member}")
                endif()
                list(APPEND seen_implementations "${member}")
                math(EXPR members "${members} + 1")
                math(EXPR producers "${producers} + 1")
            endforeach()
            if(members LESS 1 OR members GREATER 2)
                message(FATAL_ERROR "Private implementation batch is not a bounded pair")
            endif()
        elseif(source MATCHES "cmake_pch[.]hxx[.]cxx$")
            math(EXPR precompiled_headers "${precompiled_headers} + 1")
        elseif(source MATCHES "owner[.]cpp$")
            math(EXPR owners "${owners} + 1")
        elseif(source MATCHES "main[.]cpp$")
            math(EXPR consumers "${consumers} + 1")
        endif()
    endforeach()
    list(SORT seen_implementations)
    list(SORT expected_implementations)
    if(NOT seen_implementations STREQUAL expected_implementations)
        message(FATAL_ERROR "Compile commands did not cover every canonical implementation exactly once.\nExpected: ${expected_implementations}\nFound: ${seen_implementations}")
    endif()
    if(producers LESS 1 OR NOT consumers EQUAL 2 OR NOT owners EQUAL 1 OR NOT precompiled_headers EQUAL 1)
        message(FATAL_ERROR "Policy witness missed an implementation/private-header-cache/consumer/owner route")
    endif()
    if(NOT expected_profile STREQUAL "system")
        file(SHA256 "${response}" copy_sha256)
        if(NOT copy_sha256 STREQUAL canonical_sha256)
            message(FATAL_ERROR "Build-local profile copy differs from the canonical installed artifact")
        endif()
    endif()
endfunction()

configure(default unset unset success)
verify_commands("${OUTPUT_ROOT}/default build" system)
run(default-build "${CMAKE_COMMAND}" -E env --unset=PIPELANG_CXX_RESOURCE_PROFILE
    "${CMAKE_COMMAND}" --build "${OUTPUT_ROOT}/default build" --config Release --parallel 1)
run(default-run "${ctest_command}" --test-dir "${OUTPUT_ROOT}/default build" -C Release --output-on-failure)
configure(partitioned unset unset success -DPIPELANG_PROFILE_TEST_PARTITIONED=ON -DCMAKE_UNITY_BUILD=OFF)
verify_commands("${OUTPUT_ROOT}/partitioned build" system)
run(partitioned-build "${CMAKE_COMMAND}" -E env --unset=PIPELANG_CXX_RESOURCE_PROFILE
    "${CMAKE_COMMAND}" --build "${OUTPUT_ROOT}/partitioned build" --config Release --parallel 1)
run(partitioned-run "${ctest_command}" --test-dir "${OUTPUT_ROOT}/partitioned build" -C Release --output-on-failure)
configure(batch-target-opt-out unset unset success -DPIPELANG_PROFILE_TEST_DISABLE_BATCH=ON)
verify_commands("${OUTPUT_ROOT}/batch-target-opt-out build" system)
configure(batch-header-refused unset unset "BATCH_IMPLEMENTATIONS requires COMPILATION COMPILED"
    -DPIPELANG_PROFILE_TEST_BATCH_HEADER=ON)
configure(batch-operator-off unset unset "BATCH_IMPLEMENTATIONS conflicts with CMAKE_UNITY_BUILD=OFF"
    -DCMAKE_UNITY_BUILD=OFF)
configure(batch-conflicting-size unset unset "BATCH_IMPLEMENTATIONS requires paired CMAKE_UNITY_BUILD_BATCH_SIZE=2"
    -DCMAKE_UNITY_BUILD_BATCH_SIZE=3)
configure(override-invalid-env invalid-profile system success)
verify_commands("${OUTPUT_ROOT}/override-invalid-env build" system)
configure(invalid-env invalid-profile unset "Unknown PipeLang CXX resource profile")
configure(invalid-cmake system invalid-profile "Unknown PipeLang CXX resource profile")
# Some Windows launchers remove assignments with an empty value. Check what
# the child CMake process actually receives before asserting SDK selection.
set(empty_env_probe "${OUTPUT_ROOT}/empty-env-probe.cmake")
file(WRITE "${empty_env_probe}" [=[
if(DEFINED ENV{PIPELANG_CXX_RESOURCE_PROFILE})
    message("present")
else()
    message("absent")
endif()
]=])
run(empty-env-probe "${CMAKE_COMMAND}" -E env "PIPELANG_CXX_RESOURCE_PROFILE="
    "${CMAKE_COMMAND}" -P "${empty_env_probe}")
file(READ "${OUTPUT_ROOT}/empty-env-probe.output" empty_env_state)
string(STRIP "${empty_env_state}" empty_env_state)
if(empty_env_state STREQUAL "present")
    configure(empty-env "" unset "Unknown PipeLang CXX resource profile")
elseif(empty_env_state STREQUAL "absent")
    configure(empty-env "" unset success)
    verify_commands("${OUTPUT_ROOT}/empty-env build" system)
else()
    message(FATAL_ERROR "Could not determine empty compiler profile environment transport")
endif()
configure(empty-cmake system "" "Unknown PipeLang CXX resource profile")

file(READ "${OUTPUT_ROOT}/default build/profile-policy.json" default_policy)
string(JSON compiler GET "${default_policy}" compiler)
if(compiler STREQUAL "GNU")
    configure(environment gnu-conservative-gc unset success)
    verify_commands("${OUTPUT_ROOT}/environment build" gnu-conservative-gc)
    run(profile-build "${CMAKE_COMMAND}" -E env PIPELANG_CXX_RESOURCE_PROFILE=gnu-conservative-gc
        "${CMAKE_COMMAND}" --build "${OUTPUT_ROOT}/environment build" --config Release --parallel 1)
    run(profile-run "${ctest_command}" --test-dir "${OUTPUT_ROOT}/environment build" -C Release --output-on-failure)
    configure(explicit system gnu-conservative-gc success)
    verify_commands("${OUTPUT_ROOT}/explicit build" gnu-conservative-gc)
    configure(changing-selection system system success)
    verify_commands("${OUTPUT_ROOT}/changing-selection build" system)
    configure(changing-selection invalid-profile gnu-conservative-gc success)
    verify_commands("${OUTPUT_ROOT}/changing-selection build" gnu-conservative-gc)
    configure(changing-selection gnu-conservative-gc system success)
    verify_commands("${OUTPUT_ROOT}/changing-selection build" system)
    configure(changing-environment system unset success)
    verify_commands("${OUTPUT_ROOT}/changing-environment build" system)
    configure(changing-environment gnu-conservative-gc unset success)
    verify_commands("${OUTPUT_ROOT}/changing-environment build" gnu-conservative-gc)
    configure(changing-environment unset unset success)
    verify_commands("${OUTPUT_ROOT}/changing-environment build" system)
    run(profile-install "${CMAKE_COMMAND}" -E env PIPELANG_CXX_RESOURCE_PROFILE=gnu-conservative-gc
        "${CMAKE_COMMAND}" --install "${OUTPUT_ROOT}/environment build" --config Release
        --prefix "${OUTPUT_ROOT}/installed owner")
    file(GLOB_RECURSE exports "${OUTPUT_ROOT}/installed owner/lib/cmake/ProfileOwner/*.cmake")
    foreach(export IN LISTS exports)
        file(READ "${export}" exported)
        if(exported MATCHES "compiler-profiles|conservative-gc|ggc-min-")
            message(FATAL_ERROR "Producer CXX policy escaped into the installed archive export")
        endif()
    endforeach()
    if(NOT exports)
        message(FATAL_ERROR "No native owner export was produced")
    endif()

    set(private_profiles "${OUTPUT_ROOT}/mutable canonical profiles")
    file(MAKE_DIRECTORY "${private_profiles}")
    file(COPY "${canonical}" DESTINATION "${private_profiles}")
    set(policy_build "${OUTPUT_ROOT}/invalidation build")
    set(policy_command "${CMAKE_COMMAND}" -S "${fixture}/policy" -B "${policy_build}"
        "-DCMAKE_PREFIX_PATH=${relocated}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
        -DPipeLangModel_CXX_RESOURCE_PROFILE:STRING=gnu-conservative-gc
        "-DPROFILE_TEST_CANONICAL_DIRECTORY=${private_profiles}")
    if(DEFINED GENERATOR AND NOT GENERATOR STREQUAL "")
        list(APPEND policy_command -G "${GENERATOR}")
    endif()
    run(invalidation-configure ${policy_command})
    run(invalidation-initial-build "${CMAKE_COMMAND}" --build "${policy_build}" --parallel 1)
    file(READ "${policy_build}/profile-policy.json" before)
    string(JSON previous_response GET "${before}" response)
    run(timestamp-tick "${CMAKE_COMMAND}" -E sleep 1)
    file(APPEND "${private_profiles}/gnu-conservative-gc.rsp" "\n")
    run(invalidation-rebuild "${CMAKE_COMMAND}" --build "${policy_build}" --parallel 1)
    file(READ "${policy_build}/profile-policy.json" after)
    string(JSON next_response GET "${after}" response)
    if(previous_response STREQUAL next_response)
        message(FATAL_ERROR "Profile content edit did not invalidate the compile command")
    endif()
    file(READ "${policy_build}/compile_commands.json" rebuilt_commands)
    string(FIND "${rebuilt_commands}" "${next_response}" next_option)
    if(next_option EQUAL -1)
        message(FATAL_ERROR "Rebuilt policy command retained the stale response path")
    endif()
else()
    configure(non-gnu unset gnu-conservative-gc "requires the actual GNU CXX compiler")
endif()
configure(guard unset gnu-conservative-gc "requires the actual GNU CXX compiler"
    -DPIPELANG_PROFILE_TEST_COMPILER_ID:STRING=Clang)

# Only this relocated task-owned SDK is mutated, and its bytes are restored.
file(APPEND "${canonical}" "\n")
execute_process(COMMAND "${sdk_tool}" verify --prefix "${relocated}"
    --manifest "${manifest}" --sha256 "${manifest_sha256}"
    RESULT_VARIABLE tampered OUTPUT_VARIABLE tampered_output ERROR_VARIABLE tampered_error TIMEOUT 30)
file(WRITE "${OUTPUT_ROOT}/profile-tamper.output" "${tampered_output}${tampered_error}")
file(COPY_FILE "${SDK_PREFIX}/${profile_path}" "${canonical}")
if("${tampered}" STREQUAL "0")
    message(FATAL_ERROR "SDK verification accepted a changed compiler policy artifact")
endif()
run(restored-sdk-verify "${sdk_tool}" verify --prefix "${relocated}"
    --manifest "${manifest}" --sha256 "${manifest_sha256}")
file(WRITE "${OUTPUT_ROOT}/acceptance.txt"
    "Installed/default/selection/guard/producer/consumer/export/relocation/profile-integrity contracts passed. GNU content invalidation runs only on GNU.\n")
