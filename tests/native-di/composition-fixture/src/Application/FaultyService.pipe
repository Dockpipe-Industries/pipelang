module DiFixture.Application;
import DiFixture.Contracts;
import DiFixture.Root;

public Class FaultyService : IFaultyService {
    private int identity;
    private IRootService root;
    private RootDependency attemptDependency;

    public FaultyService(ConstructionPolicy policy, IIdentitySequence identities, IRootService rootService, RootDependency dependency) {
        identity = identities.Next();
        Result<int,string> admitted = policy.Read("faulty", 0);
        if (!admitted.IsSuccess)
            throw Error(admitted.Error);
        root = rootService;
        attemptDependency = dependency;
    }

    public pure int Identity() => identity;
    public pure int RootIdentity() => root.Identity();
    public pure int AttemptDependencyIdentity() => attemptDependency.Identity();
}
