module DiFixture.Root;
import DiFixture.Contracts;

public Class RootService : IRootService {
    private int identity;
    private RootDependency dependency;

    public RootService(ConstructionPolicy policy, IIdentitySequence identities, RootDependency child) {
        identity = identities.Next();
        Result<int,string> admitted = policy.Read("root", 0);
        if (!admitted.IsSuccess)
            throw Error(admitted.Error);
        dependency = child;
    }

    public pure int Identity() => identity;
    public pure int DependencyIdentity() => dependency.Identity();
}
