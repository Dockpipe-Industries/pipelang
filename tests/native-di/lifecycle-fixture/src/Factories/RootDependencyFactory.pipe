module DiLifecycle.Factories;
import DiLifecycle.Contracts;
import DiLifecycle.Resources;

public Class RootDependencyFactory {
    private ResourcePort port;

    public RootDependencyFactory(ResourcePort resourcePort) {
        port = resourcePort;
    }

    public Result<RootDependency,string> Create() {
        Result<int,string> opened = Result<int,string>.Failure("fixture.not_acquired");
        bool transferred = false;
        try {
            opened = port.Open("root-dependency", 0);
            if (!opened.IsSuccess) {
                if (opened.IsCancelled)
                    return Result<RootDependency,string>.Cancelled(opened.Error);
                return Result<RootDependency,string>.Failure(opened.Error);
            }
            RootDependency service = new RootDependency(port, opened.Value);
            transferred = true;
            return Result<RootDependency,string>.Success(service);
        } finally {
            if (opened.IsSuccess && !transferred) {
                Result<void,string> closed = port.Close(opened.Value, CancellationToken.None);
                if (!closed.IsSuccess)
                    throw Error(closed.Error);
            }
        }
    }
}
