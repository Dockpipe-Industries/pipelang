module DiLifecycle.Factories;
import DiLifecycle.Contracts;
import DiLifecycle.Resources;

public Class TransientFactory {
    private ResourcePort port;

    public TransientFactory(ResourcePort resourcePort) {
        port = resourcePort;
    }

    public Result<TransientResource,string> Create(IScopedResource dependency, ScopeStamp stamp) {
        Result<int,string> opened = Result<int,string>.Failure("fixture.not_acquired");
        bool transferred = false;
        try {
            opened = port.Open("transient", stamp.identity);
            if (!opened.IsSuccess) {
                if (opened.IsCancelled)
                    return Result<TransientResource,string>.Cancelled(opened.Error);
                return Result<TransientResource,string>.Failure(opened.Error);
            }
            TransientResource service = new TransientResource(port, opened.Value, dependency);
            transferred = true;
            return Result<TransientResource,string>.Success(service);
        } finally {
            if (opened.IsSuccess && !transferred) {
                Result<void,string> closed = port.Close(opened.Value, CancellationToken.None);
                if (!closed.IsSuccess)
                    throw Error(closed.Error);
            }
        }
    }
}
