module DiLifecycle.Resources;
import DiLifecycle.Contracts;

public Class TransientResource : ITransientResource, IResourceCleanup {
    private ResourcePort port;
    private int resource;
    private IScopedResource dependency;

    public TransientResource(ResourcePort resourcePort, int identity, IScopedResource child) {
        port = resourcePort;
        resource = identity;
        dependency = child;
    }

    public pure int Identity() => resource;
    public pure int ScopedIdentity() => dependency.Identity();

    public Result<void,string> Close(CancellationToken token) {
        Result<void,string> noted = port.Note("cleanup-live", resource, dependency.Identity());
        if (!noted.IsSuccess)
            return noted;
        return port.Close(resource, token);
    }
}
