public Record Label {
    public string text = "initial";
}

public Record Envelope {
    public Optional<Result<Label,string>> payload;
}

public Class Fundamentals {
    public float stored = 0.0;
    public int count = 0;
    public Optional<Label> label;
    public Envelope envelope;

    public pure float Decimal() => 0.1;
    public pure float Scientific() => 1.25e+3;
    public pure float Smallest() => 4.9406564584124654e-324;
    public pure float Largest() => 1.7976931348623157e308;
    public pure float Absolute(float value) => float.Abs(value);
    public pure float Root(float value) => float.Sqrt(value);
    public pure float Logarithm(float value) => float.Log(value);
    public pure float NegativeZero() => -0.0;
    public pure float Add(float left, float right) => left + right;
    public pure float Subtract(float left, float right) => left - right;
    public pure float Multiply(float left, float right) => left * right;
    public pure float Divide(float left, float right) => left / right;
    public pure bool Less(float left, float right) => left < right;
    public pure bool LessEqual(float left, float right) => left <= right;
    public pure bool Greater(float left, float right) => left > right;
    public pure bool GreaterEqual(float left, float right) => left >= right;
    public pure bool Equal(float left, float right) => left == right;
    public pure bool Different(float left, float right) => left != right;
    public pure bool Finite(float value) => float.IsFinite(value);
    public pure float FirstMinimum(float first, float second) => second < first ? second : first;
    public pure float Composed(float value) => Add(Multiply(value, 2.0), 0.5);
    public pure float SafeArm(bool safe) => safe ? 1.25 : Optional<float>.None().Value;
    public pure bool SafeAnd() => false && Optional<float>.None().Value > 0.0;
    public pure bool SafeOr() => true || Optional<float>.None().Value > 0.0;
    public pure bool DefaultNone() => !label.HasValue && !envelope.payload.HasValue;
    public pure Optional<float> Present(float value) => Optional<float>.Some(value);
    public pure Optional<float> Absent() => Optional<float>.None();
    public pure Label ReadLabel() => label.Value;

    public void SetLabel(Label value) {
        label = Optional<Label>.Some(value);
    }

    public void SetEnvelope(Envelope value) {
        envelope = value;
    }

    public float Store(float value) {
        stored = value;
        return stored;
    }

    public float MissingRollsBack() {
        count = 99;
        label = Optional<Label>.Some(Label("changed"));
        return Optional<float>.None().Value;
    }

    public int Scoped(bool early) {
        int result = 3;
        {
            int local = 7;
            result = result + local;
            {
                int nested = 11;
                if (early)
                    return result + nested;
                result = result + 1;
            }
        }
        {
            int local = 2;
            result = result + local;
        }
        return result;
    }

    public int ReturnFromBlock() {
        {
            return 41;
        }
    }
}

public Record Numeric32Box<T> { public T Value; }
public Class Binary32 {
    private Atomic<float32> cell = Atomic<float32>.Create(0f);
    public pure T Identity<T>(T value) => value;
    public pure float32 Generic() {
        Numeric32Box<float32> box = new Numeric32Box<float32> { Value = 0.1f };
        return Identity<float32>(box.Value);
    }
    public float32 Exchange(float32 value) => cell.Exchange(value);
    public float32 CompareExchange(float32 value, float32 comparand) => cell.CompareExchange(value, comparand);
    public float32 stored = 0f;
    public List<float32> values = List<float32>.Empty();
    public pure float32 Decimal() => 0.1f;
    public pure float32 Tie() => 1.000000059604644775390625f;
    public pure float32 Smallest() => 1.401298464324817e-45f;
    public pure float32 Largest() => 3.4028234663852886e38f;
    public pure float32 NegativeZero() => -0f;
    public pure float32 Add(float32 first, float32 second) => first + second;
    public pure float32 Subtract(float32 first, float32 second) => first - second;
    public pure float32 Multiply(float32 first, float32 second) => first * second;
    public pure float32 Divide(float32 first, float32 second) => first / second;
    public pure float32 Negative(float32 value) => -value;
    public pure float32 MultiplyAdd(float32 first, float32 second, float32 third) => first * second + third;
    public pure float32 FirstMinimum(float32 first, float32 second) => second < first ? second : first;
    public pure bool LessEqual(float32 first, float32 second) => first <= second;
    public pure bool Greater(float32 first, float32 second) => first > second;
    public pure bool GreaterEqual(float32 first, float32 second) => first >= second;
    public pure bool Less(float32 first, float32 second) => first < second;
    public pure bool Equal(float32 first, float32 second) => first == second;
    public pure bool Different(float32 first, float32 second) => first != second;
    public pure bool Finite(float32 value) => float32.IsFinite(value);
    public pure float32 Absolute(float32 value) => float32.Abs(value);
    public pure float32 Root(float32 value) => float32.Sqrt(value);
    public pure float32 Logarithm(float32 value) => float32.Log(value);
    public pure float32 Contact(float32 friction, float32 impulse, float32 speed) {
        float32 scale = friction * impulse / speed;
        return scale < 1f ? scale : 1f;
    }
    public float32 Store(float32 value) {
        stored = value;
        values.Add(value);
        return stored;
    }
    public float32 Rollback() {
        stored = 7f;
        values.Add(8f);
        return Optional<float32>.None().Value;
    }
}
