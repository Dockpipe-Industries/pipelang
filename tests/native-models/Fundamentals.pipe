public Interface NullableSampler {
    Result<float32?,string> Sample();
}

public Class NullableCallbacks {
    private NullableSampler sampler;
    public NullableCallbacks(NullableSampler service) {
        sampler = service;
    }
    public Result<float32?,string> Echo() => sampler.Sample();
}
