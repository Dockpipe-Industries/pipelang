public Enum FailureCode { Missing, Conflict }
public Record FailureData {
    public FailureCode code = FailureCode.Conflict;
    public string origin = "local";
    public int request = 0;
}

public Class ResultPropagation {
    public int trace = 0;
    public int cleanup = 0;
    public int caught = 0;

    private int Mark(int value) {
        trace = trace * 10 + value;
        return value;
    }

    private Result<int,FailureData> Read(int value, int mode) {
        int marked = Mark(value);
        if (mode == 1)
            return Result<int,FailureData>.Failure(FailureData(FailureCode.Conflict, "reader", marked));
        if (mode == 2)
            return Result<int,FailureData>.Cancelled(FailureData(FailureCode.Missing, "reader", marked));
        if (mode == 3)
            throw Error("reader execution fault");
        return Result<int,FailureData>.Success(marked);
    }

    private Result<bool,FailureData> Test(int value, int mode, bool result) {
        int ignored = try Read(value, mode);
        return Result<bool,FailureData>.Success(result);
    }

    private pure int Combine(int first, int second, int third) => first * 100 + second * 10 + third;

    public Result<int,FailureData> Arguments(int mode) {
        trace = 0;
        return Result<int,FailureData>.Success(Combine(Mark(1), try Read(2, mode), Mark(3)));
    }

    public Result<int,FailureData> Binary(int mode) {
        trace = 0;
        return Result<int,FailureData>.Success(Mark(1) + (try Read(2, mode)) * Mark(3));
    }

    public Result<bool,FailureData> And(bool left, int mode) {
        trace = 0;
        return Result<bool,FailureData>.Success(left && (try Test(1, mode, true)));
    }

    public Result<bool,FailureData> Or(bool left, int mode) {
        trace = 0;
        return Result<bool,FailureData>.Success(left || (try Test(1, mode, false)));
    }

    public Result<int,FailureData> Choice(bool choose, int firstMode, int secondMode) {
        trace = 0;
        return Result<int,FailureData>.Success(choose ? try Read(1, firstMode) : try Read(2, secondMode));
    }

    public Result<int?,FailureData> NullableChoice(bool choose, int mode) {
        trace = 0;
        int? result = choose ? try Read(1, mode) : null;
        return Result<int?,FailureData>.Success(result);
    }

    public Result<int,FailureData> Condition(int mode) {
        trace = 0;
        if (try Test(1, mode, true))
            return Result<int,FailureData>.Success(7);
        return Result<int,FailureData>.Success(8);
    }

    public Result<string,FailureData> CrossPayload(Result<int,FailureData> input) {
        return Result<string,FailureData>.Success(string.FromInt(try input));
    }

    public Result<void,FailureData> Void(Result<void,FailureData> input) {
        try input;
        return Result<void,FailureData>.Success();
    }

    public Result<int,FailureData> Nested(Result<Result<int,FailureData>,FailureData> input) {
        return Result<int,FailureData>.Success(try (try input));
    }

    public Result<int,FailureData> WithCleanup(int mode) {
        trace = 0;
        try {
            return Result<int,FailureData>.Success(try Read(1, mode));
        } catch (Error error) {
            caught = caught + 1;
            return Result<int,FailureData>.Success(-1);
        } finally {
            cleanup = cleanup + 1;
        }
    }

    private Result<bool,FailureData> LoopCondition(int index, int failureAt) {
        trace = trace + 1;
        if (index == failureAt)
            return Result<bool,FailureData>.Failure(FailureData(FailureCode.Conflict, "condition", index));
        return Result<bool,FailureData>.Success(index < 3);
    }

    private Result<int,FailureData> Step(int index, int failureAt) {
        if (index == failureAt)
            return Result<int,FailureData>.Cancelled(FailureData(FailureCode.Missing, "iteration", index));
        return Result<int,FailureData>.Success(index + 1);
    }

    public Result<int,FailureData> While(int failureAt) {
        trace = 0;
        int index = 0;
        while (try LoopCondition(index, failureAt)) {
            index = index + 1;
            if (index == 1)
                continue;
        }
        return Result<int,FailureData>.Success(index);
    }

    public Result<int,FailureData> For(int conditionFailure, int stepFailure) {
        trace = 0;
        int total = 0;
        for (int index = 0; try LoopCondition(index, conditionFailure); index = try Step(index, stepFailure)) {
            int inner = 0;
            while (inner < 2) {
                inner = inner + 1;
                continue;
            }
            try {
                if (index == 0)
                    continue;
                if (index == 2)
                    break;
                total = total + index;
            } finally {
                cleanup = cleanup + 1;
            }
        }
        return Result<int,FailureData>.Success(total);
    }

    public Result<int,FailureData> ForInitializer(int mode) {
        trace = 0;
        int total = 0;
        for (int index = try Read(1, mode); index < 3; index = index + 1)
            total = total + index;
        return Result<int,FailureData>.Success(total);
    }

    public Result<int,FailureData> Each(Result<List<int>,FailureData> input) {
        int total = 0;
        foreach (int value in try input) {
            if (value == 0)
                continue;
            total = total + (try Read(value, 0));
        }
        return Result<int,FailureData>.Success(total);
    }

    public Result<int,FailureData> Collection(int mode) {
        trace = 0;
        List<int> values = List<int>.Empty();
        values.Add(try Read(2, mode));
        return Result<int,FailureData>.Success(values.At(0));
    }

    public Result<int,FailureData> Assign(int mode) {
        trace = 0;
        trace = try Read(2, mode);
        return Result<int,FailureData>.Success(trace);
    }

    public pure Result<int,FailureData> Pure(Result<int,FailureData> input) {
        return Result<int,FailureData>.Success((try input) + 1);
    }

    public Result<int,FailureData> Stored(int mode) {
        trace = 0;
        Result<int,FailureData> stored = Result<int,FailureData>.Success(try Read(2, mode));
        return stored;
    }

    public Result<int,FailureData> ForNoContinue(int failureAt) {
        int total = 0;
        for (int index = 0; index < 3; index = try Step(index, failureAt))
            total = total + index;
        return Result<int,FailureData>.Success(total);
    }

    public Result<int,FailureCode> Enum(Result<int,FailureCode> input) {
        return Result<int,FailureCode>.Success((try input) + 1);
    }

    public Result<string,string> String(Result<int,string> input) {
        return Result<string,string>.Success(string.FromInt(try input));
    }

    public Result<int,FailureData> Exhaustion() {
        trace = 999;
        while (try Result<bool,FailureData>.Success(true)) { }
        return Result<int,FailureData>.Success(0);
    }

    public int Trace() => trace;
    public int CleanupCount() => cleanup;
    public int CaughtCount() => caught;
}

public Class AsyncPropagation {
    public int cleanup = 0;
    public int value = 0;
    public int calls = 0;
    private async Task<Result<int,string>> Child(int mode) {
        calls = calls + 1;
        if (mode == 1)
            return Result<int,string>.Failure("child failure");
        if (mode == 2)
            return Result<int,string>.Cancelled("child cancelled");
        return Result<int,string>.Success(7);
    }
    public async Task<Result<string,string>> Run(int mode) {
        try {
            return Result<string,string>.Success("value " + string.FromInt(try await Child(mode)));
        } finally {
            cleanup = cleanup + 1;
        }
    }
    public async Task<Result<int,string>> Assign(int mode) {
        value = 3;
        value = try await Child(mode);
        return Result<int,string>.Success(value);
    }
    public async Task<Result<int,string>> AwaitArgument(Result<int,string> input) {
        Result<int,string> result = await Child(try input);
        return result;
    }
    public int Value() => value;
    public int Calls() => calls;
    public int CleanupCount() => cleanup;
}

public Interface PropagationGate {
    Task<Result<int,string>> Read(int mode, CancellationToken cancellation);
}

public Class SuspendedPropagation {
    private PropagationGate gate;
    public int value = 0;
    public int cleanup = 0;
    public SuspendedPropagation(PropagationGate input) { gate = input; }
    public async Task<Result<int,string>> Assign(int mode, CancellationToken cancellation) {
        try {
            value = 3;
            value = try await gate.Read(mode, cancellation);
            return Result<int,string>.Success(value);
        } finally {
            cleanup = cleanup + 1;
        }
    }
}
