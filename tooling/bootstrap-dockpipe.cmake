cmake_minimum_required(VERSION 3.21.1)
# Install only the exact archive identity committed in dockpipe.lock.json.
if(NOT DEFINED OUTPUT_DIRECTORY OR NOT IS_ABSOLUTE "${OUTPUT_DIRECTORY}")
    message(FATAL_ERROR "Set -DOUTPUT_DIRECTORY to a fresh absolute directory")
endif()
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(EXISTS "${source_root}/dockpipe.config.json")
    file(READ "${source_root}/dockpipe.config.json" config)
    string(JSON version GET "${config}" dockpipe_version)
elseif(DEFINED DOCKPIPE_VERSION AND NOT DOCKPIPE_VERSION STREQUAL "")
    # Remote delivery owns its minimal project config; it never copies the sender's.
    # The explicit producer version must still match every committed artifact pin.
    set(version "${DOCKPIPE_VERSION}")
else()
    message(FATAL_ERROR "Set the exact DOCKPIPE_VERSION for source-only remote delivery")
endif()
file(READ "${source_root}/dockpipe.lock.json" lock)
string(JSON locked_version GET "${lock}" dockpipe version)
if(NOT version STREQUAL locked_version)
    message(FATAL_ERROR "DockPipe config and lock versions differ")
endif()
cmake_host_system_information(RESULT architecture QUERY OS_PLATFORM)
if(architecture MATCHES "^(x86_64|AMD64|amd64)$")
    set(architecture amd64)
elseif(architecture MATCHES "^(aarch64|arm64|ARM64)$")
    set(architecture arm64)
else()
    message(FATAL_ERROR "No locked DockPipe architecture: ${architecture}")
endif()
string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" system)
set(target "${system}/${architecture}")
foreach(key url sha256 size_bytes executable executable_size_bytes)
    string(JSON ${key} GET "${lock}" dockpipe artifacts "${target}" "${key}")
endforeach()
string(JSON release GET "${lock}" dockpipe release)
set(official "https://github.com/Dockpipe-Industries/dockpipe/releases/download/${release}/")
string(FIND "${url}" "${official}" prefix_position)
if(NOT prefix_position EQUAL 0 OR NOT executable MATCHES "^dockpipe(\\.exe)?$")
    message(FATAL_ERROR "Untrusted DockPipe lock entry")
endif()
if(EXISTS "${OUTPUT_DIRECTORY}")
    message(FATAL_ERROR "Use a fresh output directory")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}/staging")
set(payload "${OUTPUT_DIRECTORY}/release.archive")
if(DEFINED ARCHIVE)
    file(COPY_FILE "${ARCHIVE}" "${payload}")
else()
    file(DOWNLOAD "${url}" "${payload}" EXPECTED_HASH "SHA256=${sha256}"
        TLS_VERIFY ON TIMEOUT 90 STATUS download_status)
    list(GET download_status 0 download_result)
    if(NOT download_result EQUAL 0)
        message(FATAL_ERROR "Locked download failed: ${download_status}")
    endif()
endif()
file(SIZE "${payload}" actual_size)
file(SHA256 "${payload}" actual_hash)
if(NOT actual_size EQUAL size_bytes OR NOT actual_hash STREQUAL sha256)
    message(FATAL_ERROR "DockPipe archive identity differs from the lock")
endif()
# Checksummed official archives only; extract the one required executable.
file(ARCHIVE_EXTRACT INPUT "${payload}" DESTINATION "${OUTPUT_DIRECTORY}/staging" PATTERNS "${executable}")
set(candidate "${OUTPUT_DIRECTORY}/staging/${executable}")
if(IS_SYMLINK "${candidate}" OR IS_DIRECTORY "${candidate}" OR NOT EXISTS "${candidate}")
    message(FATAL_ERROR "Locked executable is not a regular file")
endif()
file(SIZE "${candidate}" candidate_size)
if(NOT candidate_size EQUAL executable_size_bytes)
    message(FATAL_ERROR "DockPipe executable size differs from the lock")
endif()
file(CHMOD "${candidate}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
execute_process(COMMAND "${candidate}" --version OUTPUT_VARIABLE actual_version
    ERROR_VARIABLE diagnostic RESULT_VARIABLE result TIMEOUT 15)
if(NOT result EQUAL 0 OR NOT diagnostic STREQUAL "" OR NOT actual_version STREQUAL "${version}\n")
    message(FATAL_ERROR "Downloaded DockPipe version differs")
endif()
file(RENAME "${candidate}" "${OUTPUT_DIRECTORY}/${executable}")
file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}/staging")
file(REMOVE "${payload}")
if(DEFINED ENV{GITHUB_ENV})
    file(APPEND "$ENV{GITHUB_ENV}" "DOCKPIPE_BIN=${OUTPUT_DIRECTORY}/${executable}\n")
endif()
message(STATUS "Verified DockPipe ${version}: ${OUTPUT_DIRECTORY}/${executable}")
