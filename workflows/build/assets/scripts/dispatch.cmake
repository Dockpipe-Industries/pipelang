cmake_minimum_required(VERSION 3.21.1)
if(NOT PIPELANG_OPERATION MATCHES "^(build|test|check|release)$")
    message(FATAL_ERROR "Select a declared PipeLang native workflow")
endif()
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
if(CMAKE_HOST_WIN32)
    find_program(native_shell NAMES powershell.exe REQUIRED)
    set(command "${native_shell}" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass
        -File "${source_root}/workflows/${PIPELANG_OPERATION}/assets/scripts/windows.ps1")
else()
    if(PIPELANG_OPERATION STREQUAL "release")
        set(script build)
    else()
        set(script "${PIPELANG_OPERATION}")
    endif()
    set(command /bin/sh "${source_root}/workflows/${PIPELANG_OPERATION}/assets/scripts/${script}.sh")
endif()
execute_process(COMMAND ${command} WORKING_DIRECTORY "${source_root}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "PipeLang ${PIPELANG_OPERATION} workflow failed: ${result}")
endif()
