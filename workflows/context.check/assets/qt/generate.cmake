foreach(required CONTEXT_SOURCE CONTEXT_COMPILER CONTEXT_OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(READ "${CONTEXT_SOURCE}" source)
set(request "{}")
string(JSON request SET "${request}" protocol "\"pipelang.native-model.v1\"")
string(JSON quoted SET "{}" value "\"placeholder\"")
# Escape the Source text for a JSON transport without a second language runtime.
string(REPLACE "\\" "\\\\" source "${source}")
string(REPLACE "\"" "\\\"" source "${source}")
string(REPLACE "\n" "\\n" source "${source}")
string(REPLACE "\r" "\\r" source "${source}")
string(REPLACE "\t" "\\t" source "${source}")
string(JSON request SET "${request}" source "\"${source}\"")
string(JSON request SET "${request}" namespace "\"qt_context_fixture\"")
file(MAKE_DIRECTORY "${CONTEXT_OUTPUT}")
file(WRITE "${CONTEXT_OUTPUT}/request.json" "${request}")
execute_process(COMMAND "${CONTEXT_COMPILER}" INPUT_FILE "${CONTEXT_OUTPUT}/request.json"
    OUTPUT_VARIABLE response RESULT_VARIABLE outcome ERROR_VARIABLE failure TIMEOUT 30)
if(NOT outcome EQUAL 0)
    message(FATAL_ERROR "Context compilation failed: ${failure}")
endif()
file(WRITE "${CONTEXT_OUTPUT}/response.json" "${response}")
string(JSON ok GET "${response}" ok)
if(NOT ok)
    message(FATAL_ERROR "Context fixture refused: ${response}")
endif()
string(JSON header GET "${response}" header)
string(JSON manifest GET "${response}" manifest)
file(WRITE "${CONTEXT_OUTPUT}/Model.hpp" "${header}")
file(WRITE "${CONTEXT_OUTPUT}/model.json" "${manifest}")
