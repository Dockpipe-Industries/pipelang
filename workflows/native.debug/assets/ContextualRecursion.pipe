module NativeProof.ContextualRecursion;

public model Class Session {
    private int cleaned = 0;

    public Session() {}

    private pure int Count(int remaining) {
        if (remaining == 0)
            return 10;
        return Count(remaining - 1) + 1;
    }

    private pure int Even(int remaining) {
        if (remaining == 0)
            return 10;
        return Odd(remaining - 1) + 2;
    }

    private pure int Odd(int remaining) {
        if (remaining == 0)
            return 10;
        return Even(remaining - 1) + 3;
    }

    private int Visit(int remaining) {
        List<int> values = List<int>.Empty();
        values.Add(remaining);
        values.Add(1);
        int total = 0;
        try {
            foreach (int value in values) {
                if (value == remaining && remaining > 1)
                    total = total + Visit(remaining - 1);
                total = total + value;
            }
            return total;
        } finally {
            cleaned = cleaned + 1;
        }
    }

    public async Task<Result<int,string>> Run(int scenario) {
        var gate = SemaphoreSlim.Create(0, 1);
        bool acquired = await gate.WaitAsync(4);
        if (acquired)
            return Result<int,string>.Failure("unexpected recursive permit");
        if (scenario == 100) {
            int total = Visit(4);
            if (cleaned != 4)
                return Result<int,string>.Failure("recursive cleanup lost a frame");
            return Result<int,string>.Success(total);
        }
        if (scenario < 0)
            return Result<int,string>.Success(Even(0 - scenario));
        return Result<int,string>.Success(Count(scenario));
    }
}
