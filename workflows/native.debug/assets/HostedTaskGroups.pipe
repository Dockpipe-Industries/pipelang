module NativeProof.HostedGroups;

public Interface Observer {
    Result<int,string> Settle(int identity);
}

public model Class Session {
    private Observer observer;
    private SemaphoreSlim permits = SemaphoreSlim.Create(0, 2);
    private List<int> settled = List<int>.Empty();

    public Session(Observer observer) {
        this.observer = observer;
    }

    public async Task<Result<int,string>> Wait(int identity, CancellationToken token) {
        try {
            await permits.WaitAsync(token);
            return Result<int,string>.Success(identity);
        } finally {
            var receipt = observer.Settle(identity);
            settled.Add(identity);
        }
    }

    public void Release() {
        permits.Release();
    }

    public pure int Settled() => settled.Count;

    public pure int Settlement(int index) => settled.At(index);
}
