module NativeProof.TypedHostResults;

public Record Fault {
    public string code;
    public int detail;
}

public Interface Port {
    Result<bool,Fault> Read(int scenario);
    Task<Result<Result<bool,Fault>,string>> ReadAsync(int scenario, CancellationToken token);
}

public Class Session {
    private Port port;

    public Session(Port port) {
        this.port = port;
    }

    public async Task<Result<int,string>> Run(int scenario, CancellationToken token) {
        var immediate = port.Read(scenario);
        var resumed = try await port.ReadAsync(scenario, token);
        if (immediate != resumed)
            return Result<int,string>.Failure("host paths produced different typed results");
        if (scenario == 0 && resumed.IsSuccess && !resumed.Value)
            return Result<int,string>.Success(42);
        if (scenario == 1 && resumed.IsFailure && resumed.Error.code == "file.missing" &&
            resumed.Error.detail == 17)
            return Result<int,string>.Success(43);
        if (scenario == 2 && resumed.IsCancelled && resumed.Error.code == "file.cancelled" &&
            resumed.Error.detail == 21)
            return Result<int,string>.Success(44);
        return Result<int,string>.Failure("unexpected typed host outcome");
    }
}
