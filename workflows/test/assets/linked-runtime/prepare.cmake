cmake_minimum_required(VERSION 3.21.1)

foreach(argument SDK_PREFIX OUTPUT_ROOT CXX_COMPILER)
    if(NOT DEFINED ${argument} OR NOT IS_ABSOLUTE "${${argument}}" OR "${${argument}}" MATCHES "[;\r\n]")
        message(FATAL_ERROR "${argument} must be one absolute path")
    endif()
endforeach()
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Linked native workflow runtime preparation requires Linux")
endif()
if(NOT RUNTIME_MODE MATCHES "^(normal|sanitizer)$")
    message(FATAL_ERROR "Runtime mode must be normal or sanitizer")
endif()
if(NOT RESOURCE_PROFILE MATCHES "^(system|gnu-conservative-gc)$")
    message(FATAL_ERROR "Unknown compiler resource profile")
endif()
if(EXISTS "${OUTPUT_ROOT}" OR IS_SYMLINK "${OUTPUT_ROOT}")
    message(FATAL_ERROR "Linked runtime preparation requires a fresh output root")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(build "${OUTPUT_ROOT}/build")

function(run name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
    file(WRITE "${OUTPUT_ROOT}/${name}.output" "${output}${error}")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Linked runtime ${name} failed: ${result}\n${output}${error}")
    endif()
endfunction()

run(configure "${CMAKE_COMMAND}" -E env --unset=CXXFLAGS --unset=CPPFLAGS --unset=LDFLAGS
    "${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}" -B "${build}" -G "Unix Makefiles"
    "-DCMAKE_PREFIX_PATH=${SDK_PREFIX}"
    "-DPipeLangModel_DIR=${SDK_PREFIX}/lib/cmake/PipeLangModel"
    "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_BUILD_TYPE:STRING="
    "-DCMAKE_CXX_FLAGS:STRING=" "-DCMAKE_EXE_LINKER_FLAGS:STRING="
    "-DCMAKE_STATIC_LINKER_FLAGS:STRING=" "-DCMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF"
    "-DPipeLangModel_CXX_RESOURCE_PROFILE:STRING=${RESOURCE_PROFILE}"
    "-DRUNTIME_MODE:STRING=${RUNTIME_MODE}")
run(build "${CMAKE_COMMAND}" --build "${build}" --target workflow_runtime --parallel 1)

file(STRINGS "${build}/archive-path.txt" archives)
list(LENGTH archives count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Runtime build did not report one archive")
endif()
list(GET archives 0 archive)
if(NOT IS_ABSOLUTE "${archive}" OR NOT EXISTS "${archive}" OR IS_DIRECTORY "${archive}" OR IS_SYMLINK "${archive}")
    message(FATAL_ERROR "Runtime build did not produce a regular absolute archive")
endif()
file(SHA256 "${archive}" archive_digest)
file(WRITE "${OUTPUT_ROOT}/runtime-archive.sha256" "${archive_digest}  ${archive}\n")
foreach(name runtime-policy.txt runtime-source-identities.txt compile_commands.json)
    if(NOT EXISTS "${build}/${name}")
        message(FATAL_ERROR "Runtime build is missing ${name}")
    endif()
    file(COPY "${build}/${name}" DESTINATION "${OUTPUT_ROOT}")
endforeach()
file(WRITE "${OUTPUT_ROOT}/archive-path.txt" "${archive}\n")

# Read back actual producer commands rather than relying only on declarations.
file(READ "${build}/compile_commands.json" commands)
string(JSON command_count LENGTH "${commands}")
if(NOT command_count EQUAL 2)
    message(FATAL_ERROR "Runtime archive must compile exactly two canonical sources")
endif()
set(compiled_names)
foreach(index RANGE 0 1)
    string(JSON compiled_source GET "${commands}" ${index} file)
    cmake_path(IS_PREFIX SDK_PREFIX "${compiled_source}" NORMALIZE installed_source)
    if(NOT installed_source)
        message(FATAL_ERROR "Runtime producer source escaped the selected installed SDK")
    endif()
    get_filename_component(compiled_name "${compiled_source}" NAME)
    list(APPEND compiled_names "${compiled_name}")
    string(JSON command GET "${commands}" ${index} command)
    separate_arguments(arguments UNIX_COMMAND "${command}")
    foreach(required -std=c++20 -pthread -Wall -Wextra -Werror -DPIPELANG_MODEL_LINKED_RUNTIME=1)
        if(NOT required IN_LIST arguments)
            message(FATAL_ERROR "Runtime command is missing ${required}")
        endif()
    endforeach()
    if(RUNTIME_MODE STREQUAL "normal")
        set(expected_optimization -O2)
    else()
        set(expected_optimization -O1)
        foreach(required -g -fsanitize=address,undefined -fno-omit-frame-pointer)
            if(NOT required IN_LIST arguments)
                message(FATAL_ERROR "Sanitizer runtime command is missing ${required}")
            endif()
        endforeach()
    endif()
    if(NOT expected_optimization IN_LIST arguments)
        message(FATAL_ERROR "Runtime command has no expected optimization")
    endif()
    foreach(argument IN LISTS arguments)
        if(argument MATCHES "^-O" AND NOT argument STREQUAL expected_optimization)
            message(FATAL_ERROR "Runtime command has a conflicting optimization: ${argument}")
        endif()
        if(argument MATCHES "^-DNDEBUG($|=)" OR argument MATCHES "^-fno-sanitize" OR
           argument MATCHES "^-g(0|1|line-tables-only)$" OR argument STREQUAL "-fno-inline")
            message(FATAL_ERROR "Runtime command weakens the declared consumer policy: ${argument}")
        endif()
    endforeach()
endforeach()
list(SORT compiled_names)
if(NOT compiled_names STREQUAL "object_domain.cpp;task_scope.cpp")
    message(FATAL_ERROR "Runtime archive source identity is not the canonical pair")
endif()
file(WRITE "${OUTPUT_ROOT}/policy-readback.txt"
    "Two canonical runtime source commands preserve the selected normal/full-g sanitizer policy.\n")
